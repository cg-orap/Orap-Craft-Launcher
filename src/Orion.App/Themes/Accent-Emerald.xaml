<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent colour schemes. Merged *after* Dark.xaml / Light.xaml so these keys win.
         Theme-independent: the same accent works on both palettes. -->

    <Color x:Key="AccentColor">#FF10B981</Color>
    <Color x:Key="AccentHoverColor">#FF34D399</Color>
    <Color x:Key="AccentPressedColor">#FF059669</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

</ResourceDictionary>
