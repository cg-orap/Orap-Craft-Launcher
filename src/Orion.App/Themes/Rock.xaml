<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深岩：深岩灰底 + 苔藓绿主色（设计稿默认主题）。
         Every key is also defined in the other palettes so the theme can be swapped at runtime. -->
    <Color x:Key="WindowBgColor">#FF0F1115</Color>
    <Color x:Key="SurfaceBgColor">#FF171A21</Color>
    <Color x:Key="SurfaceAltBgColor">#FF1E222B</Color>
    <Color x:Key="SurfaceHoverColor">#FF242935</Color>
    <Color x:Key="BorderColor">#FF2A303B</Color>
    <Color x:Key="AccentColor">#FF6FBF73</Color>
    <Color x:Key="AccentHoverColor">#FF7FD184</Color>
    <Color x:Key="AccentPressedColor">#FF5AA85F</Color>
    <Color x:Key="TextColor">#FFE8EAED</Color>
    <Color x:Key="MutedTextColor">#FF9AA3B2</Color>
    <Color x:Key="SuccessColor">#FF7BC98B</Color>
    <Color x:Key="WarningColor">#FFE5B567</Color>
    <Color x:Key="DangerColor">#FFE06C75</Color>
    <Color x:Key="ChipBgColor">#FF1E222B</Color>

    <SolidColorBrush x:Key="WindowBg" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SurfaceBg" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceAltBg" Color="{StaticResource SurfaceAltBgColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="ChipBg" Color="{StaticResource ChipBgColor}" />

    <Color x:Key="NavRailColor">#FF14171D</Color>
    <SolidColorBrush x:Key="NavRailBg" Color="{StaticResource NavRailColor}" />
    <SolidColorBrush x:Key="NavRailHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#59000000" />
</ResourceDictionary>