<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent colour scheme: Moss（苔藓绿）. Merged *after* the palette so these keys win. -->

    <Color x:Key="AccentColor">#FF6FBF73</Color>
    <Color x:Key="AccentHoverColor">#FF7FD184</Color>
    <Color x:Key="AccentPressedColor">#FF5AA85F</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

</ResourceDictionary>