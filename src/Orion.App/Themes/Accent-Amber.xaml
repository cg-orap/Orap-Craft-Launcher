<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent colour scheme: Amber. Merged *after* Dark.xaml / Light.xaml so these keys win.
         Theme-independent: the same accent works on both palettes. -->

    <Color x:Key="AccentColor">#FFF59E0B</Color>
    <Color x:Key="AccentHoverColor">#FFFBBF24</Color>
    <Color x:Key="AccentPressedColor">#FFD97706</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

</ResourceDictionary>
