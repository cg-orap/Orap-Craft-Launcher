<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette: identical keys to Dark.xaml. -->
    <Color x:Key="WindowBgColor">#FFF4F6FA</Color>
    <Color x:Key="SurfaceBgColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltBgColor">#FFF0F3F9</Color>
    <Color x:Key="SurfaceHoverColor">#FFE4EAF4</Color>
    <Color x:Key="BorderColor">#FFD8DFEA</Color>
    <Color x:Key="AccentColor">#FF2F6FE4</Color>
    <Color x:Key="AccentHoverColor">#FF4A85F0</Color>
    <Color x:Key="AccentPressedColor">#FF255CC0</Color>
    <Color x:Key="TextColor">#FF1A2130</Color>
    <Color x:Key="MutedTextColor">#FF5C6880</Color>
    <Color x:Key="SuccessColor">#FF10884F</Color>
    <Color x:Key="WarningColor">#FFB46A00</Color>
    <Color x:Key="DangerColor">#FFD02B2B</Color>
    <Color x:Key="ChipBgColor">#FFE9EEF7</Color>

    <SolidColorBrush x:Key="WindowBg" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SurfaceBg" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceAltBg" Color="{StaticResource SurfaceAltBgColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="ChipBg" Color="{StaticResource ChipBgColor}" />

    <!-- translucent navigation rail so a custom wallpaper shows through -->
    <Color x:Key="NavRailColor">#E6F7F9FC</Color>
    <SolidColorBrush x:Key="NavRailBg" Color="{StaticResource NavRailColor}" />
    <SolidColorBrush x:Key="NavRailHover" Color="#26000000" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#59000000" />

</ResourceDictionary>
