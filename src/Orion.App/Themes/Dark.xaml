<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. Every key is also defined in Light.xaml so the theme can be swapped
         at runtime without restarting the application. -->
    <Color x:Key="WindowBgColor">#FF10131A</Color>
    <Color x:Key="SurfaceBgColor">#FF181D27</Color>
    <Color x:Key="SurfaceAltBgColor">#FF212836</Color>
    <Color x:Key="SurfaceHoverColor">#FF2A3444</Color>
    <Color x:Key="BorderColor">#FF2C3646</Color>
    <Color x:Key="AccentColor">#FF4C8DFF</Color>
    <Color x:Key="AccentHoverColor">#FF6BA2FF</Color>
    <Color x:Key="AccentPressedColor">#FF3B78E0</Color>
    <Color x:Key="TextColor">#FFE9EDF5</Color>
    <Color x:Key="MutedTextColor">#FF97A3B8</Color>
    <Color x:Key="SuccessColor">#FF3DD68C</Color>
    <Color x:Key="WarningColor">#FFFFB020</Color>
    <Color x:Key="DangerColor">#FFFF5C5C</Color>
    <Color x:Key="ChipBgColor">#FF232C3B</Color>

    <SolidColorBrush x:Key="WindowBg" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SurfaceBg" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceAltBg" Color="{StaticResource SurfaceAltBgColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="ChipBg" Color="{StaticResource ChipBgColor}" />

    <!-- translucent navigation rail so a custom wallpaper shows through -->
    <Color x:Key="NavRailColor">#D9141820</Color>
    <SolidColorBrush x:Key="NavRailBg" Color="{StaticResource NavRailColor}" />
    <SolidColorBrush x:Key="NavRailHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#59000000" />

</ResourceDictionary>
