<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 暖纸：米白纸感 + 赭石主色。
         Every key is also defined in the other palettes so the theme can be swapped at runtime. -->
    <Color x:Key="WindowBgColor">#FFF3EDE2</Color>
    <Color x:Key="SurfaceBgColor">#FFFDFAF4</Color>
    <Color x:Key="SurfaceAltBgColor">#FFF6F1E7</Color>
    <Color x:Key="SurfaceHoverColor">#FFEBE2D3</Color>
    <Color x:Key="BorderColor">#FFDCD0BC</Color>
    <Color x:Key="AccentColor">#FF9B5F2A</Color>
    <Color x:Key="AccentHoverColor">#FFB06F34</Color>
    <Color x:Key="AccentPressedColor">#FF84491C</Color>
    <Color x:Key="TextColor">#FF241C12</Color>
    <Color x:Key="MutedTextColor">#FF5A4C3A</Color>
    <Color x:Key="SuccessColor">#FF5A7A2F</Color>
    <Color x:Key="WarningColor">#FF99630F</Color>
    <Color x:Key="DangerColor">#FFB23B34</Color>
    <Color x:Key="ChipBgColor">#FFF6F1E7</Color>

    <SolidColorBrush x:Key="WindowBg" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="SurfaceBg" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceAltBg" Color="{StaticResource SurfaceAltBgColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="ChipBg" Color="{StaticResource ChipBgColor}" />

    <Color x:Key="NavRailColor">#FFFAF5EC</Color>
    <SolidColorBrush x:Key="NavRailBg" Color="{StaticResource NavRailColor}" />
    <SolidColorBrush x:Key="NavRailHover" Color="#14000000" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#2E281C0C" />
</ResourceDictionary>