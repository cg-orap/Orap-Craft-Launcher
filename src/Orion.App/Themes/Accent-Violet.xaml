<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent colour scheme: Violet. Merged *after* Dark.xaml / Light.xaml so these keys win.
         Theme-independent: the same accent works on both palettes. -->

    <Color x:Key="AccentColor">#FF8B5CF6</Color>
    <Color x:Key="AccentHoverColor">#FFA78BFA</Color>
    <Color x:Key="AccentPressedColor">#FF7443E0</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

</ResourceDictionary>
