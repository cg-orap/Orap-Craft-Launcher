<Window x:Class="Orion.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录账户 — Orap Craft Launcher"
        Height="660" Width="1000" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== accounts ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,18,18,16">
                <TextBlock DockPanel.Dock="Top" Text="账户" Style="{StaticResource TitleText}" />
                <TextBlock DockPanel.Dock="Top" Text="选择要使用的账户，或登录一个新账户。"
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,14" />

                <!-- offline account -->
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="添加离线账户" Style="{StaticResource CaptionText}" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="3-16 位字母、数字或下划线" />
                        <Button Grid.Column="1" Content="添加" Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddOfflineCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="离线账户仅用于单机与局域网，不绕过正版服务器验证。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />

                    <Button Content="移除所选账户" Style="{StaticResource DangerButton}" Command="{Binding RemoveAccountCommand}"
                            Margin="0,12,0,0" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- saved accounts -->
                <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="AccountList">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Fill" Background="{DynamicResource SurfaceAltBg}"
                                                CornerRadius="10" Padding="10" BorderThickness="1"
                                                BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- skin head, with an initial badge as fallback -->
                                <Grid Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Border CornerRadius="6" Background="{DynamicResource SurfaceBg}"
                                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                            Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Text="{Binding Username, Converter={StaticResource Initial}}"
                                                   FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border CornerRadius="6" ClipToBounds="True"
                                            Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="13.5"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ==================== embedded browser ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBg}" Padding="18,14"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="微软正版账户" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding MicrosoftHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Background="{DynamicResource WindowBg}">
                <wv2:WebView2 x:Name="Browser" />

                <Border x:Name="Overlay" Background="{DynamicResource WindowBg}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28">
                        <TextBlock x:Name="OverlayTitle" Text="在这里登录微软账户"
                                   FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="OverlayText"
                                   Text="点击下方的「用浏览器登录」，会在本窗口内打开微软官方登录页；选择账户并同意后自动完成登录，无需复制任何内容。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="420" Margin="0,10,0,0" />
                        <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Width="220" Height="4"
                                     Margin="0,16,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBg}" Padding="16,12"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MicrosoftLoginButton" Content="用浏览器登录" Style="{StaticResource PrimaryButton}"
                            Click="OnMicrosoftLogin" Padding="22,10"
                            AutomationProperties.AutomationId="BrowserLoginButton" />

                    <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="14,0,10,0" TextWrapping="Wrap" MaxHeight="40"
                               AutomationProperties.AutomationId="LoginStatusText" />

                    <Button Grid.Column="2" Content="关闭" Style="{StaticResource SecondaryButton}" Click="OnClose" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
