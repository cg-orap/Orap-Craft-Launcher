<UserControl x:Class="Orion.App.Views.ToolboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Orion.App.Controls"
             xmlns:anim="clr-namespace:Orion.App.Animations"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1120">

    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="工具箱" Style="{StaticResource TitleText}" />
                <TextBlock Text="种子地图、游戏截图，以及新建版本时自动套用的游戏内设置。"
                           Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding InstanceLabel}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" />
        </Grid>

        <controls:SegmentedControl Grid.Row="1" Margin="0,0,0,14" ItemsSource="{Binding Tabs}"
                                   SelectedIndex="{Binding TabIndex, Mode=TwoWay}"
                                   AutomationProperties.AutomationId="ToolboxTabs" />

        <!-- ===== 种子地图（离线） ===== -->
        <Grid Grid.Row="2" Visibility="{Binding IsSeedTab, Converter={StaticResource BoolToVisibility}}" anim:ContentTransition.Watch="{Binding IsSeedTab}" anim:ContentTransition.Offset="6"
              PreviewMouseWheel="OnSeedPageWheel" PreviewKeyDown="OnSeedPageKeyDown" Focusable="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0"
                          AutomationProperties.AutomationId="SeedPanelScroll">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="离线种子地图" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="完全在本地计算，不联网。绿色格子是史莱姆区块（与游戏内公式逐位一致）。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" />

                        <TextBlock Text="种子（数字或任意文本）" Style="{StaticResource CaptionText}" Margin="0,14,0,0" />
                        <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="SeedBox" Margin="0,6,0,0" />

                        <Button Content="生成地图" Style="{StaticResource PrimaryButton}" Padding="16,8"
                                Margin="0,10,0,0" Command="{Binding GenerateMapCommand}"
                                AutomationProperties.AutomationId="SeedGenerate" />

                        <TextBlock Text="{Binding SeedError}" Style="{StaticResource CaptionText}"
                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="定位结构" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="选一个结构类型，从当前位置向外找最近的一个并跳过去。"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" ItemsSource="{Binding LocateStructureOptions}"
                                              SelectedItem="{Binding LocateStructureTarget, Mode=TwoWay}"
                                              DisplayMemberPath="Label" Height="30" FontSize="11.5"
                                              AutomationProperties.AutomationId="StructurePicker" />

                                    <Button Grid.Column="1" Content="找最近" Style="{StaticResource SecondaryButton}"
                                            FontSize="11" Padding="12,5" Margin="8,0,0,0"
                                            Command="{Binding FindStructureCommand}"
                                            AutomationProperties.AutomationId="FindStructureButton" />
                                </Grid>

                                <TextBlock Text="{Binding StructureLocateStatus}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="定位生物群系" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="选一个群系，从这里向外找最近的实例（最多扫 4096 格）。"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" />

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" ItemsSource="{Binding BiomeOptions}"
                                              SelectedItem="{Binding SelectedBiome, Mode=TwoWay}"
                                              DisplayMemberPath="Name" Height="30" FontSize="11.5"
                                              AutomationProperties.AutomationId="BiomePicker" />

                                    <Button Grid.Column="1" Content="寻找并定位" Style="{StaticResource SecondaryButton}"
                                            FontSize="11" Padding="12,5" Margin="8,0,0,0"
                                            Command="{Binding FindBiomeCommand}"
                                            AutomationProperties.AutomationId="FindBiomeButton" />
                                </Grid>

                                <TextBlock Text="{Binding BiomeSearchStatus}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="附近结构" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <Button Content="扫描附近结构" Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right" FontSize="11" Padding="10,5"
                                            Command="{Binding ScanStructuresCommand}"
                                            AutomationProperties.AutomationId="ScanStructuresButton" />
                                </Grid>

                                <TextBlock Text="{Binding StructureScanStatus}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />

                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding NearbyStructures}"
                                                  AutomationProperties.AutomationId="NearbyStructuresList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.LocateStructureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Cursor="Hand"
                                                        HorizontalContentAlignment="Stretch" Padding="0"
                                                        BorderThickness="0" Background="Transparent"
                                                        ToolTip="在地图上定位到这个结构">
                                                    <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="6"
                                                            Padding="10,6" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5"
                                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                            <TextBlock Grid.Column="1" Text="{Binding CoordinatesText}"
                                                                       FontFamily="Consolas" FontSize="10.5"
                                                                       Margin="10,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding DistanceText}"
                                                                       FontFamily="Consolas" FontSize="10.5"
                                                                       MinWidth="64" TextAlignment="Right"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding MapStatus}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />

                        <TextBlock Text="维度" Style="{StaticResource CaptionText}" Margin="0,14,0,0" />
                        <controls:SegmentedControl Margin="0,6,0,0" ItemsSource="{Binding Dimensions}"
                                                   SelectedIndex="{Binding DimensionIndex, Mode=TwoWay}" />
                        <TextBlock Text="{Binding DimensionHint}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="定位到坐标（方块）" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding LocateX, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="X 坐标（方块）" AutomationProperties.AutomationId="LocateXBox" />
                            <TextBox Grid.Column="2" Text="{Binding LocateZ, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Z 坐标（方块）" AutomationProperties.AutomationId="LocateZBox" />
                            <Button Grid.Column="4" Content="定位" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LocateCommand}" Padding="14,6"
                                    AutomationProperties.AutomationId="LocateGo" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="→ 下界坐标" Style="{StaticResource GhostButton}" FontSize="10.5"
                                    Padding="10,4" Command="{Binding ToNetherCommand}" />
                            <Button Content="→ 主世界坐标" Style="{StaticResource GhostButton}" FontSize="10.5"
                                    Padding="10,4" Margin="6,0,0,0" Command="{Binding ToOverworldCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="定位到出生点" Style="{StaticResource GhostButton}"
                                    Command="{Binding LocateSpawnCommand}" Padding="10,5"
                                    AutomationProperties.AutomationId="LocateSpawn" />
                            <TextBlock Text="{Binding SpawnText}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <CheckBox Content="显示结构与出生点" IsChecked="{Binding ShowStructures}"
                                  Margin="0,10,0,0" />

                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="只显示这些结构" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" />
                            <Button Content="全选/全不选" Style="{StaticResource GhostButton}" FontSize="10"
                                    Padding="8,3" HorizontalAlignment="Right"
                                    Command="{Binding ToggleAllStructuresCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding StructureFilterOptions}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              FontSize="10.5" Margin="0,0,10,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Content="显示史莱姆区块" IsChecked="{Binding ShowSlimeOverlay}"
                                  Margin="0,6,0,0" />
                        <CheckBox Content="显示网格与坐标" IsChecked="{Binding ShowGridOverlay}"
                                  Margin="0,6,0,0" />
                        <CheckBox Content="群系质感（贴图 + 描边 + 近似地形阴影）"
                                  IsChecked="{Binding ShowTextures, Mode=TwoWay}" Margin="0,6,0,0"
                                  AutomationProperties.AutomationId="TextureToggle" />
                        <TextBlock Text="{Binding MapEngineLabel}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding MapModelNotice}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="也可以在线查看" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="生物群系与地形需要完整的世界生成算法，启动器没有实现，所以不在离线图里画假数据。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Chunkbase" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenChunkbaseCommand}" />
                            <Button Content="Misland" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding OpenMislandCommand}" />
                            <Button Content="复制种子" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding CopySeedCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <controls:BiomeMapCanvas x:Name="BiomeCanvas" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="10">
                        <Button Content="放大" Style="{StaticResource SecondaryButton}" Padding="12,5"
                                Click="OnZoomIn" ToolTip="放大一档：看清更小的范围" />
                        <Button Content="缩小" Style="{StaticResource SecondaryButton}" Padding="12,5"
                                Margin="6,0,0,0" Click="OnZoomOut" ToolTip="缩小一档：看到更大的范围" />
                        <Button Content="回到原点" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                Click="OnCenterOrigin" />
                        <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="4" Padding="8,3"
                                Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ZoomHint}" FontFamily="Consolas" FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       AutomationProperties.AutomationId="ZoomHintText" />
                        </Border>
                    </StackPanel>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                            CornerRadius="6" Background="#99101318" Padding="8,5">
                        <TextBlock Text="{Binding MapStatus}" FontSize="11" Foreground="#FFE6E9EE" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 查看截图 ===== -->
        <Grid Grid.Row="2" Visibility="{Binding IsScreenshotsTab, Converter={StaticResource BoolToVisibility}}" anim:ContentTransition.Watch="{Binding IsScreenshotsTab}" anim:ContentTransition.Offset="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{Binding ScreenshotsHint}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding HasScreenshots, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="刷新" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshScreenshotsCommand}" />
                    <Button Content="打开截图目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding OpenScreenshotsFolderCommand}" />
                    <Button Content="在资源管理器显示" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding RevealScreenshotCommand}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding HasScreenshots, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                    <ListBox ItemsSource="{Binding Screenshots}" SelectedItem="{Binding SelectedScreenshot, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="68" Height="40" CornerRadius="5" Background="{DynamicResource SurfaceAltBg}">
                                        <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TakenText}" FontSize="12" />
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8">
                    <Grid>
                        <Image Source="{Binding SelectedScreenshot.Image}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="6"
                                Background="#99101318" Padding="8,4" Margin="6">
                            <TextBlock Text="{Binding SelectedScreenshot.FileName}" FontSize="11"
                                       Foreground="#FFF2F4F8" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 游戏默认设置 ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsDefaultsTab, Converter={StaticResource BoolToVisibility}}" anim:ContentTransition.Watch="{Binding IsDefaultsTab}" anim:ContentTransition.Offset="6">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="游戏默认设置" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="新建版本时把这些选项直接写进它的 options.txt，不用每次开新版本都重新调一遍。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DefaultsSummary}" Style="{StaticResource CaptionText}"
                                   Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}" />

                        <CheckBox Content="在新建版本时写入这些设置" IsChecked="{Binding DefaultsEnabled}"
                                  Margin="0,14,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="视距（2–32 区块）" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding RenderDistance, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="界面尺寸（0 = 自动）" Style="{StaticResource CaptionText}" />
                                <ComboBox ItemsSource="{Binding GuiScaleOptions}" SelectedItem="{Binding GuiScale}"
                                          Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                <TextBlock Text="视角 (FOV 30–110)" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding Fov, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Text="亮度（0.0–1.0）" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding Gamma, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                <TextBlock Text="粒子效果" Style="{StaticResource CaptionText}" />
                                <ComboBox ItemsSource="{Binding ParticlesOptions}" SelectedItem="{Binding Particles}"
                                          Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Text="游戏语言" Style="{StaticResource CaptionText}" />
                                <ComboBox ItemsSource="{Binding LangOptions}" SelectedItem="{Binding SelectedLanguage}"
                                          DisplayMemberPath="Name" Margin="0,6,0,0"
                                          AutomationProperties.AutomationId="GameLanguageCombo" />
                                <CheckBox Content="自动跳跃" IsChecked="{Binding AutoJump}" Margin="0,8,0,0" />
                                <CheckBox Content="视角摇晃" IsChecked="{Binding BobView}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="保存默认设置" Style="{StaticResource PrimaryButton}" Padding="16,8"
                                    Command="{Binding SaveDefaultsCommand}" />
                            <Button Content="应用到所有现有版本" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding ApplyDefaultsCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="写入规则" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="只改动上面这几项，其余键（按键绑定、资源包、视角、语言等）原样保留；已有值会被就地替换，不会写出重复键。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        <TextBlock Text="写入时机：新建版本时自动写入；也可以在下面手动把当前设置应用到已存在的版本。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <!-- ===== 记录（各版本启动次数 / 游玩时长）===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsRecordsTab, Converter={StaticResource BoolToVisibility}}"
                      anim:ContentTransition.Watch="{Binding IsRecordsTab}" anim:ContentTransition.Offset="6">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="游玩记录" Style="{StaticResource SectionTitle}" />
                                <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="4"
                                        Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RecordsSummary}" FontSize="10.5"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="刷新" Style="{StaticResource GhostButton}" FontSize="11"
                                        Padding="10,4" Command="{Binding RefreshRecordsCommand}" />
                                <Button Content="清空记录" Style="{StaticResource GhostButton}" FontSize="11"
                                        Padding="10,4" Margin="8,0,0,0" Command="{Binding ClearRecordsCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="统计每次启动到退出的墙钟时间；被启动器强制结束的会话也算。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <TextBlock Text="{Binding RecordsEmptyHint}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding HasRecords, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <ItemsControl ItemsSource="{Binding Records}" Margin="0,12,0,0"
                                      AutomationProperties.AutomationId="RecordsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8"
                                            Padding="12,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding LaunchesText}" FontSize="11.5"
                                                       FontFamily="Consolas" VerticalAlignment="Center"
                                                       Margin="12,0" Foreground="{DynamicResource AccentBrush}" />

                                            <TextBlock Grid.Column="2" Text="{Binding TotalPlayText}" FontSize="11.5"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                                       MinWidth="90" TextAlignment="Right" />

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="140">
                                                <TextBlock Text="{Binding LastPlayedText}" FontSize="10.5"
                                                           FontFamily="Consolas" TextAlignment="Right"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding AbnormalText}" FontSize="10"
                                                           TextAlignment="Right"
                                                           Foreground="{DynamicResource DangerBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
