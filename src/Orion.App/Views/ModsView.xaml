<UserControl x:Class="Orion.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">

    <Grid Margin="26,22,26,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="392" />
        </Grid.ColumnDefinitions>

        <!-- ===================== local mods ===================== -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Mod 管理" Style="{StaticResource TitleText}" />
                <TextBlock Text="{Binding InstanceLabel}" Style="{StaticResource CaptionText}" Margin="0,6,0,14" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButton}" Command="{Binding RescanCommand}" Margin="8,0,0,0" />
                <Button Grid.Column="2" Content="打开 mods 目录" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <ListBox ItemsSource="{Binding Mods}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Version}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0">
                                        <Run Text="{Binding Loader, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding FileName, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding SizeText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding DependencyText}" Style="{StaticResource CaptionText}"
                                               Visibility="{Binding HasDependencies, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0"
                                            Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="已启用" FontSize="11" Foreground="{DynamicResource SuccessBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0"
                                            Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Text="已禁用" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                    </Border>
                                    <Button Content="{Binding ToggleLabel}" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ToggleCommand}" Padding="10,4" />
                                    <Button Content="移除" Style="{StaticResource GhostButton}"
                                            Command="{Binding DeleteCommand}" Margin="4,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- ===================== modrinth ===================== -->
        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}" Margin="0,52,0,16">
                <StackPanel>
                    <TextBlock Text="从 Modrinth 安装" Style="{StaticResource SectionTitle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索 Mod，例如 sodium / jei" />
                        <Button Grid.Column="1" Content="搜索" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SearchCommand}" Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="搜索会按当前实例的 Minecraft 版本与加载器过滤。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />

                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="8">
                <ListBox ItemsSource="{Binding SearchResults}" MaxHeight="460">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,4,8,0" />
                                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                                        <Run Text="{Binding Author, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Downloads, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="1" Content="安装" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding InstallCommand}" VerticalAlignment="Center" Padding="12,5" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Button Content="在浏览器中打开 Modrinth" Style="{StaticResource GhostButton}"
                    Command="{Binding OpenModrinthPageCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</UserControl>
