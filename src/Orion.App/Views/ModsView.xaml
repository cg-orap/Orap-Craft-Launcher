<UserControl x:Class="Orion.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Orion.App.Controls"
             xmlns:anim="clr-namespace:Orion.App.Animations"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1120">

    <UserControl.Resources>
        <Style x:Key="ModRowItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="10,8"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAltBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTab" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="6" Background="Transparent" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,20">

            <!-- ===== 头部卡片：实例身份 + 操作 + 页签 ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10"
                                Background="{DynamicResource SurfaceAltBg}"
                                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                Margin="0,0,14,0">
                            <TextBlock Text="{Binding InstanceLabel, Converter={StaticResource Initial}}"
                                       FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="模组管理" FontSize="18" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="4" Padding="6,2">
                                    <TextBlock FontFamily="Consolas" FontSize="10.5"
                                               Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="模组 " /><Run Text="{Binding Mods.Count, Mode=OneWay}" />
                                        <Run Text=" · 已启用 " /><Run Text="{Binding EnabledCount, Mode=OneWay}" />
                                        <Run Text=" · 已禁用 " /><Run Text="{Binding DisabledCount, Mode=OneWay}" />
                                        <Run Text=" · 不兼容 " /><Run Text="{Binding IncompatibleCount, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 在本页直接切换版本 -->
                            <ComboBox ItemsSource="{Binding Instances}"
                                      SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                      Width="220" Height="30" FontSize="11.5" Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      ToolTip="切换要管理的版本"
                                      AutomationProperties.AutomationId="ModsInstancePicker">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="打开 mods 目录" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenFolderCommand}" FontSize="11.5" Padding="12,6" />
                            <Button Content="重新扫描" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RescanCommand}" FontSize="11.5" Padding="12,6" Margin="8,0,0,0" />
                            <Button Content="检查更新" Style="{StaticResource GhostButton}"
                                    Command="{Binding CheckUpdatesCommand}" FontSize="11.5" Padding="12,6" Margin="8,0,0,0"
                                    ToolTip="只检查，不下载；发现更新会先询问你" />
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                            Margin="0,14,0,0" Padding="0,10,0,0">
                        <controls:SegmentedControl ItemsSource="{Binding ModFilters}"
                                                   SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 更新预览（检查更新后出现，勾选确认才下载） ===== -->
            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0"
                    Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="可更新项" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                            <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="4" Padding="6,2"
                                    Margin="8,0,0,0">
                                <TextBlock FontFamily="Consolas" FontSize="10.5"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding Updates.Count}" />
                            </Border>
                            <TextBlock Text="勾选后点「更新所选」才会下载" FontSize="10.5" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="全选 / 全不选" Style="{StaticResource GhostButton}" FontSize="11"
                                    Padding="10,5" Command="{Binding SelectAllUpdatesCommand}" />
                            <Button Content="收起" Style="{StaticResource GhostButton}" FontSize="11"
                                    Padding="10,5" Margin="6,0,0,0" Command="{Binding DismissUpdatesCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" FontSize="11" Padding="12,5" Margin="6,0,0,0"
                                    Command="{Binding UpdateSelectedCommand}">
                                <TextBlock>
                                    <Run Text="更新所选（" /><Run Text="{Binding SelectedUpdateCount, Mode=OneWay}" /><Run Text="）" />
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Updates}" Margin="0,10,0,0"
                                  anim:StaggerIn.IsEnabled="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="6"
                                        Padding="10,7" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding FileLine}" FontFamily="Consolas" FontSize="10"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding VersionLine}" FontFamily="Consolas"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- 状态行 -->
            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="2,10,2,10"
                       TextWrapping="Wrap"
                       Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}" />

            <!-- ===== 两栏：模组列表 + 右侧概览/安装 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6" Margin="0,0,14,0">
                    <ListBox ItemsSource="{Binding ModsView}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ModRowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7"
                                            Background="{DynamicResource SurfaceAltBg}" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title, Converter={StaticResource Initial}}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding Version}" FontFamily="Consolas" FontSize="10.5"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>
                                        <TextBlock FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <Run Text="{Binding Loader, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FileName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding DependencyText}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasDependencies, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="已启用" FontSize="10.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"
                                                   Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="已禁用" FontSize="10.5" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Content="{Binding ToggleLabel}" Style="{StaticResource GhostButton}"
                                                FontSize="10.5" Padding="10,4" Command="{Binding ToggleCommand}" />
                                        <Button Content="删除" Style="{StaticResource DangerButton}"
                                                FontSize="10.5" Padding="10,4" Margin="6,0,0,0"
                                                Command="{Binding DeleteCommand}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Column="1">
                    <!-- 概览 -->
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="概览" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模组总数" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Mods.Count}" FontFamily="Consolas" FontSize="11.5" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="已启用" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding EnabledCount}" FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="不兼容" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding IncompatibleCount}" FontFamily="Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource WarningBrush}" />
                            </Grid>
                            <TextBlock Text="停用的模组不会写进启动参数。" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 从 Modrinth 安装 -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="从 Modrinth 安装" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                            <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="6" Padding="8,5"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" Margin="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="搜索 Modrinth…" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="11.5"
                                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                         VerticalAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                </Grid>
                            </Border>
                            <Button Content="搜索" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                    Command="{Binding SearchCommand}" FontSize="11.5" Padding="12,5" />
                            <TextBlock Text="搜索会按当前版本的 Minecraft 版本与加载器过滤。" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <ListBox ItemsSource="{Binding SearchResults}" MaxHeight="300" Margin="0,8,0,0"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="6"
                                                Padding="8,6" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Downloads}" FontFamily="Consolas" FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                                                <Button Content="安装" Style="{StaticResource GhostButton}" FontSize="10.5"
                                                        Padding="10,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                        Command="{Binding InstallCommand}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
