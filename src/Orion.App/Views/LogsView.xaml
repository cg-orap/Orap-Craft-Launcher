<UserControl x:Class="Orion.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="日志与诊断" Style="{StaticResource TitleText}" />
                <TextBlock Text="启动器日志、游戏输出与崩溃分析。完整日志同时写入数据目录的 logs 文件夹。"
                           Style="{StaticResource CaptionText}" Margin="0,6,0,14" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                <Button Content="复制当前视图" Style="{StaticResource SecondaryButton}" Command="{Binding CopyCommand}" />
                <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0" />
                <Button Content="清空" Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}" Margin="4,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- crash analysis -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14"
                Visibility="{Binding CrashSummary, Converter={StaticResource StringToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="崩溃分析" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Text="{Binding CrashReportPath}" Style="{StaticResource CaptionText}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding CrashSummary}" Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />

                <ItemsControl ItemsSource="{Binding CrashCauses}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- game log -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="游戏输出" FontWeight="SemiBold" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding GameLogPath}" Style="{StaticResource CaptionText}"
                               TextTrimming="CharacterEllipsis" MaxWidth="520" />
                </Grid>

                <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8" Padding="8">
                    <ListBox ItemsSource="{Binding GameLines}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </DockPanel>
        </Border>

        <!-- launcher log -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="启动器日志" FontWeight="SemiBold" Margin="0,0,0,8" />

                <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8" Padding="8">
                    <ListBox ItemsSource="{Binding LauncherLines}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
