<UserControl x:Class="Orion.App.Views.VersionPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBg}" Padding="18,14"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← 返回首页" Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}" VerticalAlignment="Center" Margin="0,0,14,0"
                        AutomationProperties.AutomationId="VersionPickerBack" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="版本选择" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="选择要启动的游戏版本。选中后会回到首页并记住这个选择。"
                               Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="18,14,18,10">
            <ListBox ItemsSource="{Binding Instances}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.AutomationId="VersionPickerList">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="{DynamicResource SurfaceAltBg}"
                                            CornerRadius="10" Padding="14,12" BorderThickness="1"
                                            BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding GameDirectory}" Style="{StaticResource MonoText}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Chip}" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayLoader}" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Border>
                                <Button Content="选择" Style="{StaticResource PrimaryButton}" Padding="18,7"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" Margin="18,0,18,12"
                   AutomationProperties.AutomationId="VersionPickerStatus"
                   Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}" />
    </Grid>
</UserControl>
