<UserControl x:Class="Orion.App.Views.SpaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1120">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,20">

            <!-- ===== 头部 ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="空间" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SharedTotalText}" Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="打开数据目录" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenDataFolderCommand}" FontSize="11.5" Padding="12,6"
                                Margin="0,0,8,0" />
                        <Button Content="重新扫描" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}" FontSize="11.5" Padding="12,6" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ===== 共享目录 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="共享目录" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="这些是各版本共用的文件，删掉会导致重新下载，所以只统计不提供删除（缓存和回收目录在下方清理选项里）。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <ItemsControl ItemsSource="{Binding SharedRows}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8"
                                        Padding="12,9" Margin="0,0,8,8" MinWidth="220">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding SizeText}" FontSize="14" FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== 实例列表 + 分类 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="实例" Style="{StaticResource SectionTitle}" />
                        <ListBox ItemsSource="{Binding Usages}" SelectedItem="{Binding SelectedUsage, Mode=TwoWay}"
                                 MaxHeight="420" Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4,2,4">
                                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SizeText}" FontSize="10.5"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding SelectedTotalText}" Style="{StaticResource CaptionText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="打开目录" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenInstanceFolderCommand}" FontSize="11" Padding="10,5"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Slices}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />

                                        <ProgressBar Grid.Column="1" Height="6" Minimum="0" Maximum="100"
                                                     Value="{Binding Percent, Mode=OneWay}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontFamily="Consolas" />

                                        <TextBlock Grid.Column="3" Text="{Binding FileText}" FontSize="10"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 清理 ===== -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="清理（白名单）" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="只清理下面勾选的内容；存档、模组、资源包、配置永远不动。所有删除都进 Windows 回收站，可还原。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="日志" IsChecked="{Binding CleanLogs, Mode=TwoWay}" Margin="0,0,16,8"
                                  VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                            <TextBlock Text="保留最近" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{Binding LogRetentionDays}" FontSize="11" FontWeight="SemiBold"
                                       Margin="6,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="天的日志" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Width="120" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Value="{Binding LogRetentionDays, Mode=TwoWay}" />
                        </StackPanel>
                        <CheckBox Content="崩溃报告" IsChecked="{Binding CleanCrashReports, Mode=TwoWay}"
                                  Margin="0,0,16,8" VerticalAlignment="Center" />
                        <CheckBox Content="下载缓存 / 临时 jar" IsChecked="{Binding CleanCache, Mode=TwoWay}"
                                  Margin="0,0,16,8" VerticalAlignment="Center" />
                        <CheckBox Content="回收目录" IsChecked="{Binding CleanTrash, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                    </WrapPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding PreviewText}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />

                        <WrapPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="预览" Style="{StaticResource GhostButton}"
                                    Command="{Binding PreviewCommand}" FontSize="11.5" Padding="12,6"
                                    Margin="0,0,8,0" />
                            <Button Content="执行清理" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CleanCommand}" FontSize="11.5" Padding="12,6" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="2,12,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
