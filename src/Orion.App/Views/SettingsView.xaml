<UserControl x:Class="Orion.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===================== left column ===================== -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="设置" Style="{StaticResource TitleText}" />
                <TextBlock Text="所有设置保存在数据目录中，不会修改系统环境变量。"
                           Style="{StaticResource CaptionText}" Margin="0,6,0,12" />
                <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,0,0,16" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="主界面外观" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="可以为主界面设置一张自定义背景图片（也可以在主界面右键更换）。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DataContext.Home.BackgroundImagePath, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding DataContext.Home.BackgroundImagePath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="选择背景图片…" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DataContext.Home.ChooseBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="恢复默认背景" Style="{StaticResource GhostButton}"
                                    Command="{Binding DataContext.Home.ClearBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="数据目录" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding DataRoot}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                        <TextBlock Text="把 portable.txt 放到 EXE 同目录即可切换为便携模式（数据保存在 data 子目录）。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="打开数据目录" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Command="{Binding OpenLogsCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Java 运行时" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="留空表示按游戏版本自动选择（推荐）。" Style="{StaticResource CaptionText}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseJavaCommand}" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Content="重新检测" Style="{StaticResource GhostButton}"
                                    Command="{Binding DetectJavaCommand}" Margin="4,0,0,0" />
                        </Grid>

                        <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                            <ListBox ItemsSource="{Binding JavaRuntimes}" MaxHeight="150">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,3">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Home}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="内存" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="最大内存 (MB)" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="初始内存 (MB)" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding MinMemoryMb, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="1.21.1 + NeoForge 建议 3072–6144 MB。"
                                   Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== right column ===================== -->
            <StackPanel Grid.Column="1" Margin="10,52,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="下载" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="下载源" Style="{StaticResource CaptionText}" />
                        <ComboBox ItemsSource="{Binding SourceOptions}" SelectedValue="{Binding Source}"
                                  SelectedValuePath="Source" DisplayMemberPath="Name" Margin="0,6,0,12" />

                        <TextBlock Text="最大并发连接数" Style="{StaticResource CaptionText}" />
                        <TextBox Text="{Binding MaxConcurrency, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                        <TextBlock Text="代理（例如 http://127.0.0.1:7890）" Style="{StaticResource CaptionText}" />
                        <TextBox Text="{Binding ProxyUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />

                        <TextBlock Text="镜像仅作为传输替代，所有文件仍按官方 SHA-1 校验。启动器不会关闭 TLS 证书验证。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="界面与日志" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="主题" Style="{StaticResource CaptionText}" />
                        <ComboBox ItemsSource="{Binding Themes}" SelectedValue="{Binding Theme}"
                                  SelectedValuePath="Key" DisplayMemberPath="Name" Margin="0,6,0,12" />

                        <TextBlock Text="主题色" Style="{StaticResource CaptionText}" />
                        <ItemsControl ItemsSource="{Binding Accents}" Margin="0,8,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="34" Height="34" Margin="0,0,8,0" Cursor="Hand"
                                            ToolTip="{Binding Name}"
                                            Tag="{Binding Key}"
                                            Click="OnAccentClick"
                                            AutomationProperties.Name="{Binding Name}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Ellipse Width="28" Height="28" x:Name="Dot">
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding Color}" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse x:Name="Ring" Width="34" Height="34" StrokeThickness="2"
                                                             Stroke="Transparent" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Content="强制游戏日志使用 UTF-8（推荐，避免中文乱码）"
                                  IsChecked="{Binding ForceUtf8Console}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="微软登录" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="如需自行发布，请填写你注册的 Azure 应用客户端 ID（留空使用内置公共客户端 ID）。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Padding="20,10" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
