<Window x:Class="Orion.App.Views.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录微软账户 — Orap Craft Launcher"
        Height="760" Width="560" MinHeight="520" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="在下方登录你的 Microsoft 账户" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="选择账户并同意后，启动器会自动完成登录，无需复制任何内容。"
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- embedded browser -->
        <Grid Grid.Row="1" Background="{DynamicResource WindowBg}">
            <!-- The WebView2 control must stay visible: EnsureCoreWebView2Async needs a live
                 window handle, which a Collapsed element does not have. Loading state is shown
                 by an overlay on top instead. -->
            <wv2:WebView2 x:Name="Browser" />

            <Border x:Name="Overlay" Background="{DynamicResource WindowBg}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="4" x:Name="LoadingBar" />
                    <TextBlock x:Name="PlaceholderText" Text="正在载入微软登录页面…"
                               Style="{StaticResource CaptionText}" Margin="0,14,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- footer -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Text="等待你在页面中完成登录…"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="改用设备代码登录" Style="{StaticResource GhostButton}" Click="OnSwitchToDeviceCode" />
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="OnCancel" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
