<UserControl x:Class="Orion.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Orion.App.Controls"
             xmlns:views="clr-namespace:Orion.App.Views"
             xmlns:anim="clr-namespace:Orion.App.Animations"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1120">

    <UserControl.Resources>
        <Style x:Key="SourceSegment" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="6" Background="Transparent" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KindChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="6" Padding="12,7"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegTab" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="14,6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KindTab" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="6" Padding="12,6" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceAltBg}" />
                                <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>    
        <!-- 统一的结果行：Modrinth 与 CurseForge 共用一个模板，保证两个来源看起来一样 -->
        <DataTemplate x:Key="MarketRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="46" Height="46" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBg}"
                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <Border CornerRadius="8" ClipToBounds="True"
                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="4" Padding="6,1">
                            <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding AuthorText}" FontSize="10" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160" />
                        <TextBlock Text="{Binding DownloadsText}" FontSize="10" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding UpdatedText}" FontSize="10" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Content="安装" Style="{StaticResource PrimaryButton}"
                        FontSize="11" Padding="12,5" VerticalAlignment="Center" Margin="12,0,0,0"
                        Command="{Binding InstallCommand}" />
            </Grid>
        </DataTemplate>

</UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部：标题 + 来源切换（详情页是独立子界面，打开时整块隐藏） -->
        <Border Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="24,18,24,8"
                Visibility="{Binding IsListChromeVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="资源市场" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Text="一键安装到当前实例，或作为新版本创建。点击卡片在右侧查看详情。" />
                    <!-- 折叠开关 + 折叠时的一行摘要 -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding FilterToggleLabel}" Style="{StaticResource GhostButton}"
                                FontSize="11" Padding="10,4" Command="{Binding ToggleFilterCommand}"
                                AutomationProperties.AutomationId="CatalogFilterToggle">
                            <Button.ContextMenu>
                                <ContextMenu />
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding FilterSummary}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsFilterExpanded, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    </Grid>

                    <StackPanel Visibility="{Binding IsFilterExpanded, Converter={StaticResource BoolToVisibility}}">
                    <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock Text="来源" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <controls:SegmentedControl ItemsSource="{Binding Sources}"
                                                   SelectedIndex="{Binding SourceIndex, Mode=TwoWay}"
                                                   AutomationProperties.AutomationId="CatalogSourceSwitch" />

                        <!-- 搜索范围：默认只列当前实例 MC 版本能用的内容，可切到不限版本 -->
                        <TextBlock Text="范围" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,10,0" />
                        <controls:SegmentedControl ItemsSource="{Binding SearchScopes}"
                                                   SelectedIndex="{Binding ScopeIndex, Mode=TwoWay}"
                                                   AutomationProperties.AutomationId="CatalogScopeSwitch" />

                    </WrapPanel>
                    <!-- 排序 + 筛选：两个来源同一套控件 -->
                    <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock Text="排序" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <controls:SegmentedControl ItemsSource="{Binding SortOptions}"
                                                   SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                                                   AutomationProperties.AutomationId="CatalogSortSwitch" />

                        <TextBlock Text="加载器" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,8,0" />
                        <ComboBox ItemsSource="{Binding LoaderOptions}" SelectedIndex="{Binding LoaderIndex, Mode=TwoWay}"
                                  Width="120" Height="28" FontSize="11.5" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="CatalogLoaderFilter" />

                        <TextBlock Text="分类" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,8,0" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  Width="180" Height="28" FontSize="11.5" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="CatalogCategoryFilter" />
                    </WrapPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding ScopeHint}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="720"
                               AutomationProperties.AutomationId="CatalogScopeHint" />
                    <controls:SegmentedControl Margin="0,8,0,0" ItemsSource="{Binding Kinds}"
                                               DisplayMemberPath="Name"
                                               SelectedIndex="{Binding KindIndex, Mode=TwoWay}" />

                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsVersionsTab, Converter={StaticResource BoolToVisibility}}">
            <views:VersionsView DataContext="{Binding VersionsPage}" />
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}"
              anim:ContentTransition.Watch="{Binding IsDetailOpen}"
              anim:ContentTransition.Offset="12"
              anim:ContentTransition.Duration="240">
            <views:CatalogDetailView DataContext="{Binding Detail}" />
        </Grid>

        <!-- 资源列表 -->
        <Grid Grid.Row="1" Margin="24,8,24,14"
              Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">

                <Border Background="{DynamicResource SurfaceBg}" CornerRadius="7" Padding="9,4"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                        VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="320" MaxWidth="460">
                    <Grid>
                        <TextBlock Text="搜索整合包、模组、光影或材质包…" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="0,2"
                                 FontSize="11.5" CaretBrush="{DynamicResource TextBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="CatalogSearchBox"
                                 ToolTip="输入关键词后按回车搜索（留空则按下载量排序）">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>


            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6"
                    Visibility="{Binding IsModrinthSource, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                    <ListBox ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0"
                             anim:StaggerIn.IsEnabled="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="OnResultClick"
                             AutomationProperties.AutomationId="CatalogList"
                             ItemTemplate="{StaticResource MarketRowTemplate}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent" CornerRadius="8"
                                                    Padding="12,10" BorderThickness="1" BorderBrush="Transparent">
                                                <Grid>
                                                    <ContentPresenter />
                                                    <!-- hover/选中：强调色淡罩在内容之上，120ms 过渡 -->
                                                    <Border x:Name="Hover" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                                            Background="{DynamicResource AccentBrush}" />
                                                    <Border x:Name="Selected" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                                            Background="{DynamicResource AccentBrush}" />
                                                    </Grid>
                                                </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                                             To="0.08" Duration="0:0:0.12">
                                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                                             To="0.16" Duration="0:0:0.12">
                                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                <!-- 首次搜索骨架屏 -->
                <controls:SkeletonList Rows="6"
                                       Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6"
                    Visibility="{Binding IsCurseForgeSource, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding CurseForgeStatus}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="6,4,6,8" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding CurseForgeResults}" Background="Transparent"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="OnCurseForgeListClick"
                             AutomationProperties.AutomationId="CatalogCurseForgeList"
                         ItemTemplate="{StaticResource MarketRowTemplate}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="2,10,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                             Fill="{DynamicResource SuccessBrush}" />
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Text" Value="来源 Modrinth（无需 Key）" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurseForgeSource}" Value="True">
                                        <Setter Property="Text" Value="来源 CurseForge（需要 API Key）" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="·" Style="{StaticResource CaptionText}" Margin="8,0" />
                    <TextBlock Text="{Binding PageText}" Style="{StaticResource CaptionText}" />
                    <Button Content="取消任务" Style="{StaticResource DangerButton}" Padding="10,3" Margin="12,0,0,0"
                            FontSize="10.5" Command="{Binding CancelOperationCommand}"
                            Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="CancelTaskButton" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="上一页" Style="{StaticResource GhostButton}" Padding="12,4" FontSize="11"
                            Command="{Binding PreviousPageCommand}" />
                    <Button Content="下一页" Style="{StaticResource GhostButton}" Padding="12,4" FontSize="11"
                            Margin="8,0,0,0" Command="{Binding NextPageCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- CurseForge 详情：与 Modrinth 详情共用同一套布局（头部 + 介绍 + 历史版本 + 状态行） -->
        <Grid Grid.Row="1" Visibility="{Binding IsCurseForgeDetailOpen, Converter={StaticResource BoolToVisibility}}"
              anim:ContentTransition.Watch="{Binding IsCurseForgeDetailOpen}"
              anim:ContentTransition.Offset="12"
              anim:ContentTransition.Duration="240">
            <Grid DataContext="{Binding CurseForgeDetail}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceBg}" Padding="20,16"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="72" Height="72" Margin="0,0,16,0">
                            <Border CornerRadius="14" Background="{DynamicResource SurfaceAltBg}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                    Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <TextBlock Text="{Binding Title, Converter={StaticResource Initial}}"
                                           FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="14" ClipToBounds="True"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                    Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="520" />
                                <Border Style="{StaticResource Chip}" Margin="10,2,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Border>
                            </StackPanel>

                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Categories}" Style="{StaticResource CaptionText}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                <TextBlock Text=" · " Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding Downloads}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text=" · " Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding TargetInfo}" Style="{StaticResource CaptionText}" />
                            </WrapPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Content="←  返回列表" Style="{StaticResource GhostButton}"
                                Command="{Binding BackCommand}"
                                VerticalAlignment="Center" Padding="12,6" FontSize="12"
                                AutomationProperties.AutomationId="CurseForgeDetailBackButton" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18,14,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,14,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="介绍" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding TranslationStatus}"
                                           Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Content="{Binding TranslateLabel}"
                                        Style="{StaticResource GhostButton}" FontSize="11" Padding="10,4"
                                        Command="{Binding TranslateCommand}"
                                        AutomationProperties.AutomationId="TranslateCurseForgeDescription"
                                        ToolTip="用 MyMemory 翻译记忆库把英文描述翻成简体中文（非大模型，需联网）" />
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{DynamicResource TextBrush}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding VersionsHeader}"
                                       Style="{StaticResource SectionTitle}" Margin="4,4,0,8" />

                            <ListBox ItemsSource="{Binding Versions}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.AutomationId="CurseForgeVersionList">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="9" Padding="10">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                                    <Run Text="支持版本 " /><Run Text="{Binding GameVersions, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding FileName}" Style="{StaticResource MonoText}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="安装" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding InstallCommand}" VerticalAlignment="Center"
                                                    Padding="12,6" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="2" anim:TextFade.Text="{Binding Status}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="18,0,18,12"
                           AutomationProperties.AutomationId="CurseForgeDetailStatus"
                           Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}" />
            </Grid>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="2" Background="#CC0B0E14" IsHitTestVisible="False"
                Visibility="{Binding DropActive, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="松开即可安装整合包" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="支持 .mrpack / CurseForge 压缩包 / 原版整合包" Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
