<UserControl x:Class="Orion.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Orion.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1120">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- page header + kind tabs -->
        <Border Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="24,18,24,10">
            <StackPanel>
                <TextBlock Text="资源市场" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                           Text="搜索并一键安装整合包、模组、光影与材质包；点击条目查看详情。" />
                <ItemsControl ItemsSource="{Binding Kinds}" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Padding="14,6"
                                    FontSize="12" Content="{Binding Name}"
                                    Command="{Binding DataContext.SelectKindCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Visibility="{Binding IsVersionsTab, Converter={StaticResource BoolToVisibility}}">
            <views:VersionsView DataContext="{Binding VersionsPage}" />
        </Grid>

        <!-- in-window project details (only the login flow uses a separate window) -->
        <Grid Grid.Row="1" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
            <views:CatalogDetailView DataContext="{Binding Detail}" />
        </Grid>

        <!-- resource catalogue -->
        <Grid Grid.Row="1" Margin="20,14,20,14"
              Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- search + category filter -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8" Padding="10,6"
                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="搜索整合包、模组、光影或材质包…" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                     FontSize="12" CaretBrush="{DynamicResource TextBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="CatalogSearchBox"
                                     ToolTip="输入关键词后按回车搜索（留空则按下载量排序）">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </Border>

                    <ComboBox Grid.Column="1" Width="150" Height="32" Margin="10,0,0,0" VerticalAlignment="Center" Padding="8,4"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              ToolTip="按类型筛选"
                              AutomationProperties.AutomationId="CatalogCategory">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="2" Content="搜索" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SearchCommand}" Padding="18,8" Margin="10,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="CatalogSearchButton" />
                </Grid>
            </Border>

            <!-- results -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                <ListBox ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="OnResultClick"
                         AutomationProperties.AutomationId="CatalogList">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="8"
                                                Padding="10,8" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAltBg}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBg}"
                                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Text="{Binding Title, Converter={StaticResource Initial}}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border CornerRadius="8" ClipToBounds="True"
                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" />
                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Author}" Style="{StaticResource CaptionText}" FontSize="10.5" />
                                        <TextBlock Text="{Binding DownloadsText}" Style="{StaticResource CaptionText}" FontSize="10.5" Margin="10,0,0,0" />
                                        <TextBlock Text="{Binding CategoryText}" Style="{StaticResource CaptionText}" FontSize="10.5" Margin="10,0,0,0" />
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="安装" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding InstallCommand}" Padding="14,6" FontSize="12" />
                                    <TextBlock Text="&#xE76C;" Margin="10,0,2,0" VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- paging + hints -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="上一页" Style="{StaticResource GhostButton}"
                                Command="{Binding PreviousPageCommand}" />
                        <Button Grid.Column="1" Content="下一页" Style="{StaticResource GhostButton}"
                                Command="{Binding NextPageCommand}" Margin="8,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding PageText}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="14,0,14,0" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="取消任务" Style="{StaticResource DangerButton}"
                                    Command="{Binding CancelOperationCommand}" Padding="14,6" Margin="0,0,10,0"
                                    AutomationProperties.AutomationId="CancelTaskButton"
                                    Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="停止正在进行的下载 / 安装" />
                            <TextBlock Text="{Binding TargetInfo}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="330" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               AutomationProperties.AutomationId="CatalogStatus"
                               Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}" />
                    <TextBlock Text="{Binding KindHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- drag & drop overlay -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#CC0B0E14" IsHitTestVisible="False"
                Visibility="{Binding DropActive, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="松开即可安装整合包" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="支持 .mrpack 以及 Modrinth 导出的 .zip" Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
