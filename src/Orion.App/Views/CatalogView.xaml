<UserControl x:Class="Orion.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Orion.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1120">

    <UserControl.Resources>
        <Style x:Key="SourceSegment" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="6" Background="Transparent" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KindChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="6" Padding="12,7"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 头部：标题 + 来源切换 -->
        <Border Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="24,18,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="资源市场" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Text="一键安装到当前实例，或作为新版本创建。点击卡片在右侧查看详情。" />
                </StackPanel>

                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="2"
                        Background="{DynamicResource SurfaceAltBg}"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SourceSegment}" Content="Modrinth"
                                Foreground="{DynamicResource TextBrush}" ToolTip="使用 Modrinth 搜索，无需 API Key" />
                        <Button Style="{StaticResource SourceSegment}" Content="CurseForge" Opacity="0.45"
                                Foreground="{DynamicResource MutedTextBrush}"
                                ToolTip="CurseForge 搜索需要 API Key，本期仅整合包安装支持" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsVersionsTab, Converter={StaticResource BoolToVisibility}}">
            <views:VersionsView DataContext="{Binding VersionsPage}" />
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
            <views:CatalogDetailView DataContext="{Binding Detail}" />
        </Grid>

        <!-- 资源列表 -->
        <Grid Grid.Row="1" Margin="24,8,24,14"
              Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource SurfaceBg}" CornerRadius="8" Padding="12,9"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="搜索整合包、模组、光影或材质包…" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                 FontSize="12.5" CaretBrush="{DynamicResource TextBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="CatalogSearchBox"
                                 ToolTip="输入关键词后按回车搜索（留空则按下载量排序）">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>

                <ItemsControl Grid.Column="1" ItemsSource="{Binding ResourceKinds}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource KindChip}" Content="{Binding Name}"
                                    Command="{Binding DataContext.SelectKindCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
                <ListBox ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="OnResultClick"
                         AutomationProperties.AutomationId="CatalogList">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="8"
                                                Padding="12,10" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAltBg}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBg}"
                                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Text="{Binding Title, Converter={StaticResource Initial}}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border CornerRadius="8" ClipToBounds="True"
                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Author}" FontSize="11.5" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Margin="0,3,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryText}" FontFamily="Consolas" FontSize="10.5"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                    <TextBlock Text="{Binding DownloadsText}" FontFamily="Consolas" FontSize="10.5"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <Border Style="{StaticResource Chip}" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </Border>
                                    <TextBlock Text="&#xE896;" VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="2" Margin="2,10,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                             Fill="{DynamicResource SuccessBrush}" />
                    <TextBlock Text="来源 Modrinth（无需 Key）" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="·" Style="{StaticResource CaptionText}" Margin="8,0" />
                    <TextBlock Text="{Binding PageText}" Style="{StaticResource CaptionText}" />
                    <Button Content="取消任务" Style="{StaticResource DangerButton}" Padding="10,3" Margin="12,0,0,0"
                            FontSize="10.5" Command="{Binding CancelOperationCommand}"
                            Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="CancelTaskButton" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="上一页" Style="{StaticResource GhostButton}" Padding="12,4" FontSize="11"
                            Command="{Binding PreviousPageCommand}" />
                    <Button Content="下一页" Style="{StaticResource GhostButton}" Padding="12,4" FontSize="11"
                            Margin="8,0,0,0" Command="{Binding NextPageCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="2" Background="#CC0B0E14" IsHitTestVisible="False"
                Visibility="{Binding DropActive, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="松开即可安装整合包" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="支持 .mrpack / CurseForge 压缩包 / 原版整合包" Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
