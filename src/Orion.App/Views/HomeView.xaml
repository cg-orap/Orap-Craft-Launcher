<UserControl x:Class="Orion.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,22,26,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="376" />
            </Grid.ColumnDefinitions>

            <!-- ===================== left: instance + launch ===================== -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="首页" Style="{StaticResource TitleText}" />
                <TextBlock Text="选择实例与账户，然后开始游戏。" Style="{StaticResource CaptionText}" Margin="0,6,0,18" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding InstanceTitle}" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InstanceSubtitle}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Margin="0,6,12,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="实例设置" Style="{StaticResource GhostButton}" Command="{Binding OpenInstanceSettingsCommand}" />
                                <Button Content="打开目录" Style="{StaticResource GhostButton}" Command="{Binding OpenGameFolderCommand}" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Content="{Binding LaunchButtonText}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding LaunchCommand}" Padding="30,11" FontSize="14" />
                            <Button Grid.Column="1" Content="结束游戏" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding StopCommand}" Margin="10,0,0,0" />
                            <TextBlock Grid.Column="2" Text="{Binding LaunchStatus}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Java 运行时" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding JavaStatus}" TextWrapping="Wrap" Margin="0,3,0,12" />
                        <TextBlock Text="版本状态" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding InstanceStatus}" TextWrapping="Wrap" Margin="0,3,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="重新检测" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="游戏实时日志" Style="{StaticResource SectionTitle}" />
                            <TextBlock HorizontalAlignment="Right" Text="最近 2000 行" Style="{StaticResource CaptionText}" />
                        </Grid>
                        <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8" Padding="8">
                            <ListBox ItemsSource="{Binding GameLog}" Height="230" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                                   TextWrapping="NoWrap" Foreground="{DynamicResource MutedTextBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Padding" Value="2,1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== right: account ===================== -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Margin="0,52,0,16">
                    <StackPanel>
                        <TextBlock Text="账户" Style="{StaticResource SectionTitle}" />

                        <ComboBox ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DataContext.CurrentAccount, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                  DisplayMemberPath="Username" />

                        <TextBlock Text="{Binding DataContext.AccountDetail, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Separator />

                        <TextBlock Text="添加离线账户" Style="{StaticResource CaptionText}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}" ToolTip="3-16 位字母、数字或下划线" />
                            <Button Grid.Column="1" Content="添加" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddOfflineAccountCommand}" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="离线账户仅用于单机与局域网，不绕过正版服务器验证。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Separator />

                        <TextBlock Text="微软正版账户" Style="{StaticResource CaptionText}" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="在浏览器中登录" Style="{StaticResource SecondaryButton}" Command="{Binding BeginMicrosoftLoginCommand}"
                                    AutomationProperties.AutomationId="BeginMicrosoftLoginButton" />
                            <Button Content="复制登录链接" Style="{StaticResource GhostButton}" Command="{Binding CopyLoginLinkCommand}" Margin="6,0,0,0"
                                    Visibility="{Binding HasMicrosoftLoginUrl, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="刷新令牌" Style="{StaticResource GhostButton}" Command="{Binding RefreshTokenCommand}" Margin="6,0,0,0" />
                        </StackPanel>

                        <!-- 登录链接常驻显示：浏览器没弹出时，用户可以自己复制到任意浏览器打开。 -->
                        <TextBox Text="{Binding MicrosoftLoginUrl, Mode=OneWay}" IsReadOnly="True"
                                 Margin="0,8,0,0" Height="52" TextWrapping="Wrap" AcceptsReturn="False"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                 Foreground="{DynamicResource MutedTextBrush}"
                                 Visibility="{Binding HasMicrosoftLoginUrl, Converter={StaticResource BoolToVisibility}}"
                                 ToolTip="选中后按 Ctrl+C 可复制；下方“粘贴回调链接”用于粘贴登录结果" />

                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="登录完成后，把地址栏里的整段链接（或回调页给出的授权码）复制下来即可——启动器会自动读取剪贴板并完成登录。授权码只有几分钟有效期且只能用一次，若提示已过期请重新登录。" />

                        <!-- 粘贴框始终可用：右键有粘贴菜单，也可用下方按钮直接从剪贴板读取。 -->
                        <TextBox Margin="0,6,0,0" Height="64" TextWrapping="Wrap" AcceptsReturn="False"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="MicrosoftCallbackBox"
                                 Text="{Binding MicrosoftCallback, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="支持完整回调链接、code=… 片段，或直接粘贴授权码；按 Enter 可直接完成登录">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CompleteMicrosoftLoginCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="从剪贴板登录" Style="{StaticResource PrimaryButton}" Command="{Binding LoginFromClipboardCommand}"
                                    AutomationProperties.AutomationId="LoginFromClipboardButton"
                                    ToolTip="读取剪贴板里的回调链接并立即登录（最快，推荐）" />
                            <Button Content="完成登录" Style="{StaticResource SecondaryButton}" Command="{Binding CompleteMicrosoftLoginCommand}" Margin="8,0,0,0" />
                            <Button Content="粘贴" Style="{StaticResource GhostButton}" Command="{Binding PasteCallbackCommand}" Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="PasteCallbackButton" />
                            <Button Content="清空" Style="{StaticResource GhostButton}" Command="{Binding ClearCallbackCommand}" Margin="4,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding MicrosoftCodeHint}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}"
                                   AutomationProperties.AutomationId="MicrosoftCodeHintText"
                                   Visibility="{Binding MicrosoftCodeHint, Converter={StaticResource StringToVisibility}}" />

                        <TextBlock Text="{Binding MicrosoftStatus}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   AutomationProperties.AutomationId="MicrosoftStatusText"
                                   Visibility="{Binding MicrosoftStatus, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Orion Launcher 0.1.0" FontWeight="SemiBold" />
                        <TextBlock Text="基于 Mojang 公开的版本清单与启动协议独立实现，仅使用官方与获授权的下载源。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Separator />
                        <TextBlock Text="本软件不包含任何绕过正版验证的功能。在线模式服务器仍需正版账户登录。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
