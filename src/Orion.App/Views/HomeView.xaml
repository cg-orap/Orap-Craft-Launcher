<UserControl x:Class="Orion.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:anim="clr-namespace:Orion.App.Animations"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="LaunchPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="10" Background="{DynamicResource AccentBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.98" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.98" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="更换背景图片…" Command="{Binding ChooseBackgroundCommand}" />
                <MenuItem Header="恢复默认背景" Command="{Binding ClearBackgroundCommand}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,28">

                <Border Style="{StaticResource HomeCard}" Padding="24,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- 实例头像：有整合包图标就显示图标，否则用"名字哈希渐变 + 首字母" -->
                            <Border Width="72" Height="72" CornerRadius="12" ClipToBounds="True" Margin="0,0,16,0"
                                    Background="{Binding InstanceAvatarBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                    AutomationProperties.AutomationId="InstanceAvatar">
                                <Grid>
                                    <TextBlock Text="{Binding InstanceTitle, Converter={StaticResource Initial}}"
                                               FontSize="28" FontWeight="Bold" Foreground="#F2FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasInstanceIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    <Image Source="{Binding InstanceIcon}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasInstanceIcon, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="当前版本" Style="{StaticResource MetaText}" />
                                <TextBlock Text="{Binding InstanceTitle}" FontSize="21" FontWeight="SemiBold"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding InstanceSubtitle}" FontSize="10.5"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="LaunchButton" Style="{StaticResource LaunchPrimary}"
                                    Command="{Binding LaunchCommand}"
                                    Click="OnLaunchClick"
                                    AutomationProperties.AutomationId="LaunchButton">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding LaunchButtonText}" Foreground="#FFFFFF" FontSize="15"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="LaunchVersionLine" />

                                    <!-- 忙碌三点：启动过程中在按钮内跳动（减少动效时不动） -->
                                    <StackPanel Orientation="Horizontal" Margin="6,2,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}">
                                        <Ellipse Width="4" Height="4" Fill="#FFFFFF" Margin="0,0,4,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                    <Style.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0.3" To="1" Duration="0:0:0.45"
                                                                                     AutoReverse="True" BeginTime="0:0:0" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse Width="4" Height="4" Fill="#FFFFFF" Margin="0,0,4,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                    <Style.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0.3" To="1" Duration="0:0:0.45"
                                                                                     AutoReverse="True" BeginTime="0:0:0.15" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse Width="4" Height="4" Fill="#FFFFFF">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                    <Style.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0.3" To="1" Duration="0:0:0.45"
                                                                                     AutoReverse="True" BeginTime="0:0:0.3" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Content="结束游戏" Style="{StaticResource DangerButton}" Margin="10,0,0,0"
                                    Height="44" Command="{Binding StopCommand}"
                                    Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="420"
                                    ClipToBounds="True">
                                <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" AutomationProperties.AutomationId="StatusJava" />
                                <TextBlock Text="·" Style="{StaticResource MetaText}" Margin="10,0" />
                                <TextBlock Text="{Binding MemoryUsageText}" Style="{StaticResource MetaText}"
                                           VerticalAlignment="Center" AutomationProperties.AutomationId="StatusMemory" />
                                <TextBlock Text="·" Style="{StaticResource MetaText}" Margin="10,0" />
                                <TextBlock Text="{Binding StateText}" Style="{StaticResource MetaText}"
                                           VerticalAlignment="Center" AutomationProperties.AutomationId="StatusState" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HomeCard}" Padding="20,14" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="内存" Style="{StaticResource MetaText}" />
                            <TextBlock Text="{Binding MemoryUsageText}" FontFamily="Consolas" FontSize="12"
                                       Margin="0,4,0,6" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <ProgressBar anim:AnimatedValue.To="{Binding MemoryPercent}" Maximum="100" Height="4" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,18,0">
                            <TextBlock Text="CPU" Style="{StaticResource MetaText}" />
                            <TextBlock Text="{Binding CpuText}" FontFamily="Consolas" FontSize="12" Margin="0,4,0,6" />
                            <ProgressBar anim:AnimatedValue.To="{Binding CpuPercent}" Maximum="100" Height="4" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,18,0">
                            <TextBlock Text="GPU" Style="{StaticResource MetaText}" />
                            <TextBlock Text="{Binding GpuText}" FontFamily="Consolas" FontSize="12" Margin="0,4,0,6" />
                            <ProgressBar anim:AnimatedValue.To="{Binding GpuPercent}" Maximum="100" Height="4" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="运行状态" Style="{StaticResource MetaText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StateText}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,20,0,10">
                    <TextBlock Text="最近游玩" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Instances}" anim:StaggerIn.IsEnabled="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBg}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                            Background="{DynamicResource SurfaceAltBg}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" FontFamily="Consolas"
                                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="&#xE76C;" VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource HomeCard}" Padding="16,12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="最近备份" Style="{StaticResource MetaText}" />
                            <TextBlock Text="今天 22:35 · 412 MB" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource HomeCard}" Padding="16,12" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="存储占用" Style="{StaticResource MetaText}" />
                            <TextBlock Text="实例 2.6 GB · 缓存 812 MB" FontSize="12" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource HomeCard}" Padding="16,12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="公告 · 11-02" Style="{StaticResource MetaText}" />
                            <TextBlock Text="备份时间线与快照回滚已上线" FontSize="12" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,54" CornerRadius="10" Padding="16,9"
                Background="{DynamicResource SurfaceAltBg}" BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}">
            <Border.RenderTransform>
                <TranslateTransform Y="0" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasToast}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" From="10" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ToastText}" FontSize="12"
                       AutomationProperties.AutomationId="LaunchToast" />
        </Border>
    </Grid>
</UserControl>
