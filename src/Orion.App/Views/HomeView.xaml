<UserControl x:Class="Orion.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1120">

    <UserControl.Resources>
        <Style x:Key="LaunchHeroButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="264" />
            <Setter Property="Padding" Value="46,20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" CornerRadius="16" Background="{DynamicResource AccentBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.45" Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource MutedTextBrush}" />
                                <Setter TargetName="Shell" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The window paints the wallpaper and its scrim behind every page, so this view stays
         transparent; only the launch controls live here. -->
    <Grid Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="更换背景图片…" Command="{Binding ChooseBackgroundCommand}" />
                <MenuItem Header="恢复默认背景" Command="{Binding ClearBackgroundCommand}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <!-- version picker: choose which game to start, right on the home page -->
            <ComboBox Width="320" HorizontalAlignment="Center"
                      ItemsSource="{Binding Instances}"
                      SelectedItem="{Binding SelectedLaunchInstance, Mode=TwoWay}"
                      AutomationProperties.AutomationId="VersionPicker"
                      ToolTip="选择要启动的版本">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Content="{Binding LaunchButtonText}" Style="{StaticResource LaunchHeroButton}"
                    Command="{Binding LaunchCommand}" Margin="0,14,0,0"
                    AutomationProperties.AutomationId="LaunchButton" />

            <!-- progress / result of the launch only -->
            <TextBlock Text="{Binding LaunchStatus}" HorizontalAlignment="Center" TextAlignment="Center"
                       MaxWidth="560" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}"
                       AutomationProperties.AutomationId="LaunchStatusText"
                       Visibility="{Binding LaunchStatus, Converter={StaticResource StringToVisibility}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                        Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}">
                <Button Content="结束游戏" Style="{StaticResource GhostButton}" Command="{Binding StopCommand}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="右键可更换背景图片" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,16,12" FontSize="11" Opacity="0.55"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
    </Grid>
</UserControl>
