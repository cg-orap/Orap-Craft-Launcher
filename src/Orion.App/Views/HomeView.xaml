<UserControl x:Class="Orion.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1120">

    <UserControl.Resources>
        <Style x:Key="LaunchHeroButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="280" />
            <Setter Property="Padding" Value="40,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                                                <Border x:Name="Shell" CornerRadius="18" BorderThickness="1" BorderBrush="#33FFFFFF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                                    <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.55" Color="{DynamicResource AccentColor}" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#66FFFFFF" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource MutedTextBrush}" />
                                <Setter TargetName="Shell" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The window paints the wallpaper and its scrim behind every page, so this view stays
         transparent; only the launch controls live here. -->
    <Grid Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="更换背景图片…" Command="{Binding ChooseBackgroundCommand}" />
                <MenuItem Header="恢复默认背景" Command="{Binding ClearBackgroundCommand}" />
            </ContextMenu>
        </Grid.ContextMenu>
        <!-- Centre-bottom placement: the block is pushed below the vertical centre on purpose. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3.6*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="24,0,24,0">
            <!-- account identity sits right above the launch button -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBg}"
                            Visibility="{Binding DataContext.HasCurrentAccountAvatar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding DataContext.CurrentAccount.Username, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Initial}}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="8" ClipToBounds="True"
                            Visibility="{Binding DataContext.HasCurrentAccountAvatar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding DataContext.CurrentAccountAvatar, RelativeSource={RelativeSource AncestorType=Window}}"
                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding DataContext.AccountDisplay, RelativeSource={RelativeSource AncestorType=Window}}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
            <!-- PCL-style launch button: the action in large text, the target version underneath -->
            <Button Style="{StaticResource LaunchHeroButton}" Width="360" Height="88"
                    Command="{Binding LaunchCommand}"
                    AutomationProperties.AutomationId="LaunchButton">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LaunchButtonText}" HorizontalAlignment="Center"
                               FontSize="23" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    <TextBlock Text="{Binding LaunchVersionLine}" HorizontalAlignment="Center"
                               FontSize="12" Margin="0,6,0,0" MaxWidth="320"
                               Foreground="#D9FFFFFF"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               AutomationProperties.AutomationId="LaunchVersionLine" />
                </StackPanel>
            </Button>

            <!-- secondary actions, side by side like the reference launcher -->
            <Grid Margin="0,12,0,0" HorizontalAlignment="Center" Width="360">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="版本选择" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenVersionPickerCommand}" Margin="0,0,6,0"
                        HorizontalAlignment="Stretch" Padding="0,9"
                        AutomationProperties.AutomationId="VersionPickerButton"
                        ToolTip="打开版本选择页，挑一个已安装的版本" />

                <Button Grid.Column="1" Content="版本设置" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenVersionSettingsCommand}" Margin="6,0,0,0"
                        HorizontalAlignment="Stretch" Padding="0,9"
                        AutomationProperties.AutomationId="VersionSettingsButton"
                        ToolTip="在「版本管理」中调整这个版本的内存、Java 与窗口设置" />
            </Grid>



                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                            Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="结束游戏" Style="{StaticResource GhostButton}" Command="{Binding StopCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- bottom status bar: environment, memory, run state -->
            <Border Grid.Row="2" VerticalAlignment="Bottom" Margin="20,0,20,14" CornerRadius="14" Padding="18,12"
                    Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                    AutomationProperties.AutomationId="HomeStatusBar">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Java 环境" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding RuntimeText}" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   AutomationProperties.AutomationId="StatusJava" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="内存使用" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding MemoryUsageText}" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0"
                                   AutomationProperties.AutomationId="StatusMemory" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="16,0,0,0">
                        <TextBlock Text="运行状态" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="13" Margin="0,3,0,0"
                                   AutomationProperties.AutomationId="StatusState" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- floating toast: launch hints appear here and fade away on their own -->
            <Border x:Name="Toast" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,96" CornerRadius="10" Padding="18,10"
                    Background="#E6111720" BorderBrush="#33FFFFFF" BorderThickness="1"
                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <TextBlock Text="{Binding ToastText}" Foreground="#F2FFFFFF" FontSize="12.5"
                           AutomationProperties.AutomationId="LaunchToast" />
            </Border>
        </Grid>

        <TextBlock Text="右键可更换背景图片" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,16,12" FontSize="11" Opacity="0.55"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
    </Grid>
</UserControl>
