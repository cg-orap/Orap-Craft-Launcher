<UserControl x:Class="Orion.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1120">

    <UserControl.Resources>
        <!-- Keeps the button readable on top of any user picture. -->
        <LinearGradientBrush x:Key="ScrimBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B3000000" Offset="0" />
            <GradientStop Color="#66000000" Offset="0.45" />
            <GradientStop Color="#B3000000" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="LaunchHeroButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="260" />
            <Setter Property="Padding" Value="46,20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" CornerRadius="16" Background="{DynamicResource AccentBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.45" Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource MutedTextBrush}" />
                                <Setter TargetName="Shell" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- layer 1: background -->
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.35" GradientOrigin="0.5,0.3" RadiusX="1.1" RadiusY="1.1">
                <GradientStop Color="{DynamicResource SurfaceAltBgColor}" Offset="0" />
                <GradientStop Color="{DynamicResource WindowBgColor}" Offset="0.72" />
            </RadialGradientBrush>
        </Grid.Background>

        <!-- background is user supplied: right-click to change it -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="更换背景图片…" Command="{Binding ChooseBackgroundCommand}" />
                <MenuItem Header="恢复默认背景" Command="{Binding ClearBackgroundCommand}" />
            </ContextMenu>
        </Grid.ContextMenu>


        <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisibility}}" />

        <!-- layer 3: the launch button, centred -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <TextBlock Text="{Binding InstanceTitle}" HorizontalAlignment="Center"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="460" />

            <Button Content="{Binding LaunchButtonText}" Style="{StaticResource LaunchHeroButton}"
                    Command="{Binding LaunchCommand}" Margin="0,14,0,0"
                    AutomationProperties.AutomationId="LaunchButton" />

            <!-- progress / result of the launch: the only text on this page -->
            <TextBlock Text="{Binding LaunchStatus}" HorizontalAlignment="Center" TextAlignment="Center"
                       MaxWidth="560" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}"
                       AutomationProperties.AutomationId="LaunchStatusText"
                       Visibility="{Binding LaunchStatus, Converter={StaticResource StringToVisibility}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                        Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}">
                <Button Content="结束游戏" Style="{StaticResource GhostButton}" Command="{Binding StopCommand}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="右键可更换背景图片" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,16,12" FontSize="11" Opacity="0.55"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
    </Grid>
</UserControl>
