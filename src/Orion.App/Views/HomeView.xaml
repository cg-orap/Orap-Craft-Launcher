<UserControl x:Class="Orion.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1120">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,18,16,18" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <!-- Both columns are proportional: a fixed pixel column next to "*" collapses the
                     text column on narrow windows (which used to wrap text character by character). -->
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- left column: version and launch -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="首页" Style="{StaticResource TitleText}" />
                <TextBlock Text="选择版本与账户，然后开始游戏。" Style="{StaticResource CaptionText}" Margin="0,6,0,16" />

                <!-- current version -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{Binding InstanceTitle}" FontSize="20" FontWeight="SemiBold"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding InstanceSubtitle}" Style="{StaticResource CaptionText}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Top">
                                <TextBlock Text="当前版本" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,14,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Content="{Binding LaunchButtonText}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding LaunchCommand}" Padding="34,12" FontSize="14"
                                    MinWidth="140" AutomationProperties.AutomationId="LaunchButton" />
                            <Button Grid.Column="1" Content="结束游戏" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding StopCommand}" Margin="10,0,0,0" Padding="16,12" />
                        </Grid>

                        <!-- Own row on purpose: sharing the button row squeezes this text into one
                             character per line once the window gets narrow. -->
                        <TextBlock Text="{Binding LaunchStatus}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding LaunchStatus, Converter={StaticResource StringToVisibility}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="版本设置" Style="{StaticResource GhostButton}" Command="{Binding OpenInstanceSettingsCommand}" />
                            <Button Content="打开目录" Style="{StaticResource GhostButton}" Command="{Binding OpenGameFolderCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- runtime -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}" Margin="0" />
                            <Button Grid.Column="1" Content="重新检测" Style="{StaticResource GhostButton}"
                                    Command="{Binding RefreshCommand}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="JAVA 运行时" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding JavaStatus}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="版本状态" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding InstanceStatus}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- live log -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="游戏实时日志" Style="{StaticResource SectionTitle}" Margin="0" />
                            <TextBlock HorizontalAlignment="Right" Text="最近 2000 行" Style="{StaticResource CaptionText}" />
                        </Grid>
                        <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8" Padding="8" Margin="0,10,0,0">
                            <ListBox ItemsSource="{Binding GameLog}" Height="220" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                                   TextWrapping="NoWrap" Foreground="{DynamicResource MutedTextBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Padding" Value="2,1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- right column: account -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="账户" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />

                        <!-- signed-in account summary -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SurfaceAltBg}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding DataContext.CurrentAccount.Username, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Initial}}"
                                           FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.AccountDisplay, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DataContext.AccountDetail, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Style="{StaticResource CaptionText}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <ComboBox ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DataContext.CurrentAccount, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                  DisplayMemberPath="Username" />

                        <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,16,0,14" />

                        <!-- offline account -->
                        <TextBlock Text="添加离线账户" Style="{StaticResource CaptionText}" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}" ToolTip="3-16 位字母、数字或下划线" />
                            <Button Grid.Column="1" Content="添加" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddOfflineAccountCommand}" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="离线账户仅用于单机与局域网，不绕过正版服务器验证。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,16,0,14" />

                        <!-- microsoft account -->
                        <TextBlock Text="微软正版账户" Style="{StaticResource CaptionText}" />

                        <Button Content="用浏览器登录（推荐）" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoginInBrowserCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="BrowserLoginButton"
                                ToolTip="在启动器内打开微软登录页面，登录后自动完成，无需复制链接" />

                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="设备代码登录" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LoginWithDeviceCodeCommand}"
                                    AutomationProperties.AutomationId="DeviceCodeLoginButton"
                                    ToolTip="在任意浏览器输入一个短代码即可登录（需要自己的应用 ID）" />
                            <Button Content="取消" Style="{StaticResource GhostButton}" Command="{Binding CancelMicrosoftLoginCommand}"
                                    Margin="6,0,0,0"
                                    Visibility="{Binding MicrosoftLoginBusy, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="刷新令牌" Style="{StaticResource GhostButton}" Command="{Binding RefreshTokenCommand}" Margin="6,0,0,0" />
                        </WrapPanel>

                        <Button Content="浏览器自动回调登录" Style="{StaticResource GhostButton}"
                                Command="{Binding LoginWithLoopbackCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="LoopbackLoginButton"
                                ToolTip="用系统浏览器登录，本地端口接收回调（需要自己的应用 ID）" />

                        <!-- device code panel -->
                        <Border Visibility="{Binding HasDeviceCode, Converter={StaticResource BoolToVisibility}}"
                                Background="{DynamicResource SurfaceAltBg}" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="在浏览器页面中输入下面的代码：" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding DeviceCodeText}" FontFamily="Cascadia Mono, Consolas"
                                           FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"
                                           AutomationProperties.AutomationId="DeviceCodeValue" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="复制代码" Style="{StaticResource SecondaryButton}" Command="{Binding CopyDeviceCodeCommand}" />
                                    <Button Content="打开登录页" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDeviceCodePageCommand}" Margin="8,0,0,0" />
                                </WrapPanel>
                                <TextBlock Text="{Binding DeviceCodeUrl}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- own Azure app id guidance -->
                        <Border Visibility="{Binding NeedsClientId, Converter={StaticResource BoolToVisibility}}"
                                Background="{DynamicResource SurfaceAltBg}" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ModernLoginUnavailableReason}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
                                <TextBox Text="{Binding ClientIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                                         ToolTip="Azure 应用（客户端）ID，形如 12345678-1234-1234-1234-123456789012" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="保存" Style="{StaticResource SecondaryButton}" Command="{Binding SaveClientIdCommand}" />
                                    <Button Content="如何获取？" Style="{StaticResource GhostButton}" Command="{Binding OpenAzureGuideCommand}" Margin="6,0,0,0" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- status -->
                        <TextBlock Text="{Binding MicrosoftStatus}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   AutomationProperties.AutomationId="MicrosoftStatusText"
                                   Visibility="{Binding MicrosoftStatus, Converter={StaticResource StringToVisibility}}" />

                        <TextBlock Text="{Binding MicrosoftCodeHint}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource AccentBrush}"
                                   AutomationProperties.AutomationId="MicrosoftCodeHintText"
                                   Visibility="{Binding MicrosoftCodeHint, Converter={StaticResource StringToVisibility}}" />

                        <!-- legacy paste (collapsed by default) -->
                        <Button Content="旧版粘贴登录方式（备用）" Style="{StaticResource GhostButton}"
                                Command="{Binding ToggleLegacyPasteCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />

                        <StackPanel Visibility="{Binding ShowLegacyPaste, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <WrapPanel>
                                <Button Content="打开旧版登录页" Style="{StaticResource SecondaryButton}" Command="{Binding BeginMicrosoftLoginCommand}"
                                        AutomationProperties.AutomationId="BeginMicrosoftLoginButton" />
                                <Button Content="复制登录链接" Style="{StaticResource GhostButton}" Command="{Binding CopyLoginLinkCommand}" Margin="6,0,0,0"
                                        Visibility="{Binding HasMicrosoftLoginUrl, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>

                            <TextBox Text="{Binding MicrosoftLoginUrl, Mode=OneWay}" IsReadOnly="True"
                                     Margin="0,8,0,0" Height="42" TextWrapping="Wrap" AcceptsReturn="False"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                     Foreground="{DynamicResource MutedTextBrush}"
                                     Visibility="{Binding HasMicrosoftLoginUrl, Converter={StaticResource BoolToVisibility}}" />

                            <TextBox Margin="0,8,0,0" Height="54" TextWrapping="Wrap" AcceptsReturn="False"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.AutomationId="MicrosoftCallbackBox"
                                     Text="{Binding MicrosoftCallback, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="支持完整回调链接、code=… 片段，或直接粘贴授权码">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CompleteMicrosoftLoginCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="从剪贴板登录" Style="{StaticResource SecondaryButton}" Command="{Binding LoginFromClipboardCommand}"
                                        AutomationProperties.AutomationId="LoginFromClipboardButton" />
                                <Button Content="完成登录" Style="{StaticResource SecondaryButton}" Command="{Binding CompleteMicrosoftLoginCommand}" Margin="6,0,0,0" />
                                <Button Content="粘贴" Style="{StaticResource GhostButton}" Command="{Binding PasteCallbackCommand}" Margin="4,0,0,0"
                                        AutomationProperties.AutomationId="PasteCallbackButton" />
                                <Button Content="清空" Style="{StaticResource GhostButton}" Command="{Binding ClearCallbackCommand}" Margin="4,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- about -->
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <TextBlock Text="Orap Craft Launcher 0.1.0" FontWeight="SemiBold" />
                        <TextBlock Text="基于 Mojang 公开的版本清单与启动协议独立实现，仅使用官方与获授权的下载源。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12,0,10" />
                        <TextBlock Text="本软件不包含任何绕过正版验证的功能。在线模式服务器仍需正版账户登录。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
