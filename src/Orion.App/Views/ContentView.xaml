<UserControl x:Class="Orion.App.Views.ContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Orion.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1120">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,20">

            <!-- ===== 头部：版本 + 操作 ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="资源" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InstanceLabel}" Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                   HorizontalAlignment="Right">
                            <ComboBox ItemsSource="{Binding Instances}"
                                      SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                      Width="220" Height="30" FontSize="11.5" Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      ToolTip="切换要管理的版本"
                                      AutomationProperties.AutomationId="ContentInstancePicker">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="打开目录" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenFolderCommand}" CommandParameter="packs"
                                    FontSize="11.5" Padding="12,6" Margin="0,0,8,0" />
                            <Button Content="重新扫描" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshCommand}" FontSize="11.5" Padding="12,6" />
                        </WrapPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                            Margin="0,14,0,0" Padding="0,10,0,0">
                        <controls:SegmentedControl ItemsSource="{Binding Tabs}"
                                                   SelectedIndex="{Binding TabIndex, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 资源包 ===== -->
            <StackPanel Visibility="{Binding IsPacksTab, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="资源包" Style="{StaticResource SectionTitle}" />
                            <TextBlock Grid.Column="1" Text="{Binding PacksHint}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ResourcePacks}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8"
                                            Padding="12,9" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Style="{StaticResource SecondaryButton}" FontSize="10.5"
                                                    Padding="10,5" VerticalAlignment="Center" MinWidth="64"
                                                    Command="{Binding ToggleCommand}"
                                                    Content="{Binding ToggleLabel}" />

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding FileName}" FontSize="10"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text=" · " FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding SizeText}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text=" · " FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding FormatText}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="上移" Style="{StaticResource GhostButton}"
                                                        FontSize="10.5" Padding="9,4" Margin="0,0,6,0"
                                                        Command="{Binding MoveUpCommand}" />
                                                <Button Content="下移" Style="{StaticResource GhostButton}"
                                                        FontSize="10.5" Padding="9,4" Margin="0,0,6,0"
                                                        Command="{Binding MoveDownCommand}" />
                                                <Button Content="删除" Style="{StaticResource DangerButton}"
                                                        FontSize="10.5" Padding="9,4"
                                                        Command="{Binding DeleteCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="这个版本还没有任何资源包。可以到「下载中心 → 资源包」里装一个。"
                                   Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   Visibility="{Binding ResourcePacks.Count, Converter={StaticResource ZeroToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 光影 ===== -->
            <StackPanel Visibility="{Binding IsShadersTab, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="光影" Style="{StaticResource SectionTitle}" />
                            <Button Grid.Column="1" Content="打开光影目录" Style="{StaticResource GhostButton}"
                                    FontSize="11" Padding="10,5"
                                    Command="{Binding OpenFolderCommand}" CommandParameter="shaders" />
                        </Grid>

                        <TextBlock Text="{Binding ShaderHint}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ShaderPath}" Style="{StaticResource CaptionText}"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />

                        <ItemsControl ItemsSource="{Binding ShaderPacks}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8"
                                            Padding="12,9" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Style="{StaticResource SecondaryButton}" FontSize="10.5"
                                                    Padding="10,5" VerticalAlignment="Center" MinWidth="64"
                                                    Command="{Binding ToggleCommand}"
                                                    Content="{Binding ToggleLabel}" />

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding FileName}" FontSize="10"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text=" · " FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding SizeText}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="删除" Style="{StaticResource DangerButton}"
                                                    FontSize="10.5" Padding="9,4" VerticalAlignment="Center"
                                                    Command="{Binding DeleteCommand}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="光影目录是空的。下载中心里装的光影会出现在这里。"
                                   Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   Visibility="{Binding ShaderPacks.Count, Converter={StaticResource ZeroToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 数据包 ===== -->
            <StackPanel Visibility="{Binding IsDatapacksTab, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据包" Style="{StaticResource SectionTitle}" />
                            <Button Grid.Column="1" Content="打开存档目录" Style="{StaticResource GhostButton}"
                                    FontSize="11" Padding="10,5"
                                    Command="{Binding OpenFolderCommand}" CommandParameter="datapacks" />
                        </Grid>

                        <TextBlock Text="{Binding DatapacksHint}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="17" />

                        <ItemsControl ItemsSource="{Binding Datapacks}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8"
                                            Padding="12,9" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12"
                                                               FontFamily="Consolas" />
                                                    <TextBlock Text="  世界：" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding WorldName}" FontSize="10.5"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding SizeText}" FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="删除" Style="{StaticResource DangerButton}"
                                                    FontSize="10.5" Padding="9,4" VerticalAlignment="Center"
                                                    Command="{Binding DeleteCommand}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="存档目录里还没有数据包。数据包一般由整合包或作者提供，放在 saves/&lt;世界&gt;/datapacks。"
                                   Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   Visibility="{Binding Datapacks.Count, Converter={StaticResource ZeroToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="2,12,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
