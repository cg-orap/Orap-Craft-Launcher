<UserControl x:Class="Orion.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:anim="clr-namespace:Orion.App.Animations"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="下载管理" Style="{StaticResource TitleText}" />
            <TextBlock Text="安装、下载与启动任务的实时进度；失败任务会同时写入日志目录下的 JSON 报告。"
                       Style="{StaticResource CaptionText}" Margin="0,6,0,12" />
                <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,0,0,16" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 并发数只在「设置 → 网络与下载」里调，这里只放操作按钮，
                     以前并排放"保存"和"打开日志目录"会在窄窗口下挤成 "保存 目录" -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="打开日志目录" Style="{StaticResource GhostButton}"
                            Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" />
                    <Button Content="打开下载目录" Style="{StaticResource GhostButton}"
                            Command="{Binding OpenDownloadsFolderCommand}" Margin="0,0,8,0" />
                    <Button Content="清除已完成" Style="{StaticResource GhostButton}"
                            Command="{Binding ClearFinishedCommand}" />
                </WrapPanel>

                <TextBlock Grid.Column="1" Text="{Binding DataContext.Activities.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="320" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ListBox ItemsSource="{Binding Items}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="14" />
                                <TextBlock Text="{Binding StartedDisplay}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding Speed}" Style="{StaticResource CaptionText}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <Button Content="取消" Style="{StaticResource DangerButton}" Padding="10,3" FontSize="11"
                                        Margin="0,0,8,0" Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding StateText, Converter={StaticResource StateToVisibility}}"
                                        AutomationProperties.AutomationId="CancelActivityButton"
                                        ToolTip="终止这个任务（不影响其它任务）" />
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding StateText}" FontSize="11" />
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" anim:AnimatedValue.To="{Binding Fraction}" Maximum="1" />
                                <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="11.5"
                                           FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"
                                           AutomationProperties.AutomationId="DownloadPercent" />
                            </Grid>

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Error}" Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="DownloadError"
                                       Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
