<UserControl x:Class="Orion.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="下载管理" Style="{StaticResource TitleText}" />
            <TextBlock Text="安装、下载与启动任务的实时进度；失败任务会同时写入日志目录下的 JSON 报告。"
                       Style="{StaticResource CaptionText}" Margin="0,6,0,16" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="最大并发下载数" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Text="{Binding MaxConcurrency, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Content="保存" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SaveConcurrencyCommand}" Margin="10,0,0,0" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Command="{Binding OpenLogFolderCommand}" />
                    <Button Content="打开缓存目录" Style="{StaticResource GhostButton}" Command="{Binding OpenDownloadsFolderCommand}" />
                    <Button Content="清除已完成" Style="{StaticResource GhostButton}" Command="{Binding ClearFinishedCommand}" />
                </StackPanel>

                <TextBlock Grid.Column="4" Text="{Binding DataContext.Activities.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ListBox ItemsSource="{Binding Items}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="14" />
                                <TextBlock Text="{Binding StartedDisplay}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding Speed}" Style="{StaticResource CaptionText}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding StateText}" FontSize="11" />
                                </Border>
                            </StackPanel>

                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Fraction}" Maximum="1" Margin="0,8,0,0" />

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Error}" Style="{StaticResource CaptionText}"
                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
