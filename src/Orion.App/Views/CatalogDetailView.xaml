<UserControl x:Class="Orion.App.Views.CatalogDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBg}" Padding="18,14"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="← 返回列表" Style="{StaticResource GhostButton}"
                        Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        VerticalAlignment="Center" Margin="0,0,14,0"
                        AutomationProperties.AutomationId="DetailBackButton" />

                <Grid Grid.Column="1" Width="64" Height="64" Margin="0,0,14,0">
                    <Border CornerRadius="11" Background="{DynamicResource SurfaceAltBg}"
                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding Title, Converter={StaticResource Initial}}"
                                   FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="11" ClipToBounds="True"
                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="520" />
                        <Border Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Border>
                    </StackPanel>

                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding Author}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding DownloadsText}" Style="{StaticResource CaptionText}" Margin="14,0,0,0" />
                        <TextBlock Text="{Binding FollowsText}" Style="{StaticResource CaptionText}" Margin="14,0,0,0" />
                        <TextBlock Text="{Binding CategoryText}" Style="{StaticResource CaptionText}" Margin="14,0,0,0" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- description + versions -->
        <Grid Grid.Row="1" Margin="18,14,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="介绍" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{DynamicResource TextBrush}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding VersionsHeader}"
                               Style="{StaticResource SectionTitle}" Margin="4,4,0,8" />

                    <ListBox ItemsSource="{Binding Versions}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.AutomationId="VersionList">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="9" Padding="10">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ChannelIcon}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0">
                                            <Run Text="MC " /><Run Text="{Binding GameVersions, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                                            <Run Text="加载器 " /><Run Text="{Binding Loaders, Mode=OneWay}" />
                                            <Run Text="  ·  " /><Run Text="{Binding Published, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource MonoText}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="安装" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding InstallCommand}" VerticalAlignment="Center"
                                            Padding="12,6" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap" Margin="18,0,18,12"
                   AutomationProperties.AutomationId="DetailStatus"
                   Visibility="{Binding Status, Converter={StaticResource StringToVisibility}}" />
    </Grid>
</UserControl>
