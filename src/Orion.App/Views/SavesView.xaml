<UserControl x:Class="Orion.App.Views.SavesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Orion.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1120">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,20">

            <!-- ===== 头部 ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="存档与截图" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InstanceLabel}" Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Instances}"
                                      SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                      Width="220" Height="30" FontSize="11.5" Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      ToolTip="切换要管理的版本"
                                      AutomationProperties.AutomationId="SavesInstancePicker">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="备份目录" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenBackupFolderCommand}" FontSize="11.5" Padding="12,6"
                                    Margin="0,0,8,0" />
                            <Button Content="重新扫描" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshCommand}" FontSize="11.5" Padding="12,6" />
                        </WrapPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                            Margin="0,14,0,0" Padding="0,10,0,0">
                        <controls:SegmentedControl ItemsSource="{Binding Tabs}"
                                                   SelectedIndex="{Binding TabIndex, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 存档 ===== -->
            <StackPanel Visibility="{Binding IsWorldsTab, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="存档" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding WorldsCountText}" Style="{StaticResource CaptionText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="打开 saves" Style="{StaticResource GhostButton}"
                                        Command="{Binding OpenSaveFolderCommand}" FontSize="11" Padding="10,5"
                                        Margin="0,0,8,0" />
                                <Button Content="从备份恢复…" Style="{StaticResource GhostButton}"
                                        Command="{Binding RestoreBackupCommand}" FontSize="11" Padding="10,5" />
                            </WrapPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Worlds}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8"
                                            Padding="12,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                                    <Border Background="{DynamicResource SurfaceBg}" CornerRadius="4"
                                                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding VersionText}" FontSize="10"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource SurfaceBg}" CornerRadius="4"
                                                            Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding HasGameType, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding GameTypeText}" FontSize="10"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding LastPlayedText}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text=" · " FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding SizeText}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text=" · " FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding FolderName}" FontSize="10"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text="  " FontSize="10" />
                                                    <TextBlock Text="{Binding SeedText}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Visibility="{Binding HasSeed, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="备份" Style="{StaticResource SecondaryButton}"
                                                        FontSize="10.5" Padding="10,4" Margin="0,0,6,0"
                                                        Command="{Binding BackupCommand}" />
                                                <Button Content="目录" Style="{StaticResource GhostButton}"
                                                        FontSize="10.5" Padding="10,4" Margin="0,0,6,0"
                                                        Command="{Binding OpenFolderCommand}" />
                                                <Button Content="删除" Style="{StaticResource DangerButton}"
                                                        FontSize="10.5" Padding="10,4"
                                                        Command="{Binding DeleteCommand}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="这个版本还没有存档。进游戏新建一个世界后会出现在这里。"
                                   Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   Visibility="{Binding Worlds.Count, Converter={StaticResource ZeroToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 截图 ===== -->
            <StackPanel Visibility="{Binding IsScreenshotsTab, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="截图" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding ScreenshotsCountText}" Style="{StaticResource CaptionText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="打开截图目录" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenScreenshotFolderCommand}" FontSize="11" Padding="10,5" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Screenshots}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8"
                                            Padding="8" Margin="0,0,10,10" Width="220">
                                        <StackPanel>
                                            <Border CornerRadius="6" ClipToBounds="True" Height="124"
                                                    Background="{DynamicResource SurfaceBg}">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border>

                                            <TextBlock Text="{Binding FileName}" FontSize="10"
                                                       FontFamily="Consolas" Margin="2,6,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="2,2,0,0">
                                                <TextBlock Text="{Binding Dimensions}" FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Text=" · " FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>

                                            <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="打开" Style="{StaticResource GhostButton}"
                                                        FontSize="10" Padding="8,3" Margin="0,0,6,0"
                                                        Command="{Binding OpenCommand}" />
                                                <Button Content="删除" Style="{StaticResource DangerButton}"
                                                        FontSize="10" Padding="8,3"
                                                        Command="{Binding DeleteCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="还没有截图。游戏里按 F2 截的图会出现在这里。"
                                   Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   Visibility="{Binding Screenshots.Count, Converter={StaticResource ZeroToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="2,12,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
