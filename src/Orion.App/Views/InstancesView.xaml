<UserControl x:Class="Orion.App.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">

    <Grid Margin="20,16,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== instance list ===================== -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="版本管理" Style="{StaticResource TitleText}" />
                <TextBlock Text="每个版本拥有独立的游戏目录（存档、Mod、配置互不影响）。"
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,12" />
                <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,0,0,16" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                <ListBox ItemsSource="{Binding DataContext.Instances, RelativeSource={RelativeSource AncestorType=Window}}"
                         SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,8">
                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="新建版本" Style="{StaticResource SectionTitle}" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="版本名称（可留空）" />
                    <ComboBox ItemsSource="{Binding VersionOptions}" SelectedItem="{Binding NewVersion}" Margin="0,8,0,0" />
                    <Button Content="创建" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" Margin="0,10,0,0" />
                    <Button Content="导入 .minecraft / Prism 版本…" Style="{StaticResource SecondaryButton}" Command="{Binding ImportCommand}" Margin="0,8,0,0" />
                    <Button Content="导入 Modrinth 整合包 (.mrpack)…" Style="{StaticResource SecondaryButton}" Command="{Binding ImportPackCommand}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== configuration ===================== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,52,0,16">
                    <StackPanel>
                        <TextBlock Text="版本设置" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding SelectionDetail}" Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="名称" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                                <TextBlock Text="最大内存 (MB)" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                                <TextBlock Text="窗口宽度" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Java 路径（留空自动选择）" Style="{StaticResource CaptionText}" />
                                <Grid Margin="0,6,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BrowseJavaCommand}" Margin="6,0,0,0" Padding="10,6" />
                                </Grid>

                                <TextBlock Text="窗口高度" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                                <CheckBox Content="全屏启动" IsChecked="{Binding Fullscreen}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="自定义 JVM 参数" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                        <TextBox Text="{Binding JvmArguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                 ToolTip="例如 -XX:+UseG1GC -Dfile.encoding=UTF-8" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                            <Button Content="检查完整性 / 修复" Style="{StaticResource SecondaryButton}" Command="{Binding VerifyCommand}" Margin="8,0,0,0" />
                            <Button Content="打开游戏目录" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="打开版本目录" Style="{StaticResource GhostButton}" Command="{Binding OpenVersionFolderCommand}" />
                            <Button Content="导出整合包" Style="{StaticResource SecondaryButton}" Command="{Binding ExportPackCommand}" Margin="8,0,0,0" />
                            <Button Content="移除版本" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="移除策略" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                                   Text="移除版本时不会永久删除文件：整个版本目录会被移动到数据目录下的 trash 文件夹，可随时手动恢复。外部导入的版本只会解除注册，绝不修改原目录。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
