<UserControl x:Class="Orion.App.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Orion.App.Controls"
             xmlns:anim="clr-namespace:Orion.App.Animations"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1120">

    <UserControl.Resources>
        <Style x:Key="DetailTab" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="6" Background="Transparent" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,20">

            <!-- ===== 头部：实例身份 + 操作 + 页签 ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="10"
                                Background="{DynamicResource SurfaceAltBg}"
                                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                Margin="0,0,16,0">
                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource Initial}}"
                                       FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding SelectionDetail}" Style="{StaticResource CaptionText}"
                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="4" Padding="7,3"
                                        Margin="0,0,8,0">
                                    <TextBlock FontFamily="Consolas" FontSize="10.5"
                                               Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="内存 " /><Run Text="{Binding MemoryMb, Mode=OneWay}" /><Run Text=" MB" />
                                    </TextBlock>
                                </Border>
                                <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="4" Padding="7,3"
                                        Margin="0,0,8,0">
                                    <TextBlock FontFamily="Consolas" FontSize="10.5"
                                               Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="窗口 " /><Run Text="{Binding WindowWidth, Mode=OneWay}" /><Run Text="×" /><Run Text="{Binding WindowHeight, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="4" Padding="7,3">
                                    <TextBlock FontFamily="Consolas" FontSize="10.5"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260"
                                               Text="{Binding JavaPath, TargetNullValue='Java 自动选择'}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="打开游戏目录" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenFolderCommand}" FontSize="11.5" Padding="12,6" />
                            <Button Content="删除版本" Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteCommand}" FontSize="11.5" Padding="12,6" Margin="8,0,0,0"
                                    ToolTip="把整个版本目录放进 Windows 回收站，可从资源管理器还原" />
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                            Margin="0,16,0,0" Padding="0,10,0,0">
                        <controls:SegmentedControl ItemsSource="{Binding DetailTabs}"
                                                   SelectedIndex="{Binding TabIndex, Mode=TwoWay}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 概览 ===== -->
            <Grid Margin="0,14,0,0"
                  Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVisibility}}" anim:ContentTransition.Watch="{Binding IsOverviewTab}" anim:ContentTransition.Offset="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="版本信息" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,0,0,8" />
                        <Grid Margin="0,4">
                            <TextBlock Text="名称" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource StatValue}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        </Grid>

                        <Grid Margin="0,4">
                            <TextBlock Text="最大内存" Style="{StaticResource StatLabel}" />
                            <TextBlock Style="{StaticResource StatValue}">
                                <Run Text="{Binding MemoryMb, Mode=OneWay}" /><Run Text=" MB" />
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="窗口尺寸" Style="{StaticResource StatLabel}" />
                            <TextBlock Style="{StaticResource StatValue}">
                                <Run Text="{Binding WindowWidth, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding WindowHeight, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="全屏启动" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding Fullscreen}" Style="{StaticResource StatValue}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Java" Style="{StaticResource StatLabel}" />
                            <TextBlock Text="{Binding JavaPath, TargetNullValue='自动选择'}" Style="{StaticResource StatValue}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        </Grid>
                        <TextBlock Text="每个版本拥有独立的游戏目录（存档、Mod、配置互不影响）。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="操作" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,0,8" />
                            <Button Content="检查完整性 / 修复" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding VerifyCommand}" FontSize="11.5" Padding="12,6"
                                    HorizontalAlignment="Stretch" />
                            <Button Content="打开版本目录" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenVersionFolderCommand}" FontSize="11.5" Padding="12,6"
                                    Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                            <Button Content="导出整合包" Style="{StaticResource GhostButton}"
                                    Command="{Binding ExportPackCommand}" FontSize="11.5" Padding="12,6"
                                    Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="新建版本" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,0,8" />
                            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="版本名称（可留空）" FontSize="11.5" />
                            <ComboBox ItemsSource="{Binding VersionOptions}" SelectedItem="{Binding NewVersion}"
                                      Margin="0,6,0,0" FontSize="11.5" />
                            <Button Content="创建" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}"
                                    FontSize="11.5" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                            <Button Content="导入 .minecraft / Prism…" Style="{StaticResource GhostButton}"
                                    Command="{Binding ImportCommand}" FontSize="11" Padding="10,5"
                                    Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                            <Button Content="导入整合包 (.mrpack)…" Style="{StaticResource GhostButton}"
                                    Command="{Binding ImportPackCommand}" FontSize="11" Padding="10,5"
                                    Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== 模组 ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0"
                    Visibility="{Binding IsModsTab, Converter={StaticResource BoolToVisibility}}" anim:ContentTransition.Watch="{Binding IsModsTab}" anim:ContentTransition.Offset="6">
                <StackPanel>
                    <TextBlock Text="模组" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="这个版本的模组在「模组」页面里集中管理：启用 / 禁用、删除、从 Modrinth 安装。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button Content="打开模组管理" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                            HorizontalAlignment="Left" FontSize="11.5" Padding="14,6"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="mods" />
                </StackPanel>
            </Border>

            <!-- ===== 存档 ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0"
                    Visibility="{Binding IsSavesTab, Converter={StaticResource BoolToVisibility}}" anim:ContentTransition.Watch="{Binding IsSavesTab}" anim:ContentTransition.Offset="6">
                <StackPanel>
                    <TextBlock Text="存档" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="存档位于该版本的 saves 目录，和其他版本完全隔离。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button Content="打开游戏目录" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                            HorizontalAlignment="Left" FontSize="11.5" Padding="14,6"
                            Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </Border>

            <!-- ===== 日志 ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0"
                    Visibility="{Binding IsLogsTab, Converter={StaticResource BoolToVisibility}}" anim:ContentTransition.Watch="{Binding IsLogsTab}" anim:ContentTransition.Offset="6">
                <StackPanel>
                    <TextBlock Text="日志" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="启动与崩溃日志在「日志」页面查看：支持级别筛选、搜索与崩溃报告归档。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button Content="打开日志页" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                            HorizontalAlignment="Left" FontSize="11.5" Padding="14,6"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="logs" />
                </StackPanel>
            </Border>

            <!-- ===== 快照 ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0"
                    Visibility="{Binding IsSnapshotTab, Converter={StaticResource BoolToVisibility}}" anim:ContentTransition.Watch="{Binding IsSnapshotTab}" anim:ContentTransition.Offset="6">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="快照" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="把 saves / config / mods 打包存一份；恢复前会自动再拍一张「恢复前」快照。"
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="刷新" Style="{StaticResource GhostButton}" FontSize="11.5" Padding="12,6"
                                    Click="OnRefreshSnapshots" />
                            <Button Content="创建快照" Style="{StaticResource PrimaryButton}" FontSize="11.5" Padding="14,6"
                                    Margin="8,0,0,0" Command="{Binding CreateSnapshotCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding SnapshotsHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasSnapshots, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent" CornerRadius="8"
                                                    Padding="2" BorderThickness="1" BorderBrush="Transparent">
                                                <Grid>
                                                    <ContentPresenter />
                                                    <!-- hover/选中：强调色淡罩在内容之上，120ms 过渡 -->
                                                    <Border x:Name="Hover" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                                            Background="{DynamicResource AccentBrush}" />
                                                    <Border x:Name="Selected" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                                            Background="{DynamicResource AccentBrush}" />
                                                    </Grid>
                                                </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                                             To="0.08" Duration="0:0:0.12">
                                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                                             To="0.16" Duration="0:0:0.12">
                                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                                                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8" Padding="12,10"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7"
                                                Background="{DynamicResource SurfaceBg}" Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE81C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TimeText}" FontSize="12.5" />
                                                <Border Background="{DynamicResource SurfaceBg}" CornerRadius="4"
                                                        Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding TriggerLabel}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontFamily="Consolas" FontSize="10" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}">
                                                <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FileCount, Mode=OneWay}" /><Run Text=" 个文件" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="恢复" Style="{StaticResource GhostButton}" FontSize="10.5"
                                                    Padding="10,4"
                                                    Command="{Binding DataContext.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="删除" Style="{StaticResource DangerButton}" FontSize="10.5"
                                                    Padding="10,4" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ListBox>

                    <!-- 单条恢复：选中快照的内容清单 -->
                    <Border Background="{DynamicResource SurfaceAltBg}" CornerRadius="8" Padding="12,10" Margin="0,6,0,0"
                            Visibility="{Binding HasSelectedSnapshot, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="内容（可单独恢复）" FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="10"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="只替换选中条目，其它存档与配置不动" />
                            </Grid>

                            <TextBlock Text="{Binding SnapshotEntriesHint}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding HasSnapshotEntries, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                            <ItemsControl ItemsSource="{Binding SnapshotEntries}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding RelativePath}" FontFamily="Consolas"
                                                       FontSize="10.5" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding KindLabel}" FontSize="10"
                                                       Margin="10,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontFamily="Consolas"
                                                       FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <Button Grid.Column="3" Content="恢复此条" Style="{StaticResource GhostButton}"
                                                    FontSize="10" Padding="8,3"
                                                    Command="{Binding DataContext.RestoreEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 设置 ===== -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0"
                    Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVisibility}}" anim:ContentTransition.Watch="{Binding IsSettingsTab}" anim:ContentTransition.Offset="6">
                <StackPanel>
                    <TextBlock Text="版本设置" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="名称" Style="{StaticResource CaptionText}" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                            <TextBlock Text="最大内存 (MB)" Style="{StaticResource CaptionText}" />
                            <TextBox Text="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                            <TextBlock Text="窗口宽度" Style="{StaticResource CaptionText}" />
                            <TextBox Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Java 路径（留空自动选择）" Style="{StaticResource CaptionText}" />
                            <Grid Margin="0,6,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="…" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseJavaCommand}" Margin="6,0,0,0" Padding="10,6" />
                            </Grid>

                            <TextBlock Text="窗口高度" Style="{StaticResource CaptionText}" />
                            <TextBox Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                            <CheckBox Content="全屏启动" IsChecked="{Binding Fullscreen}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="自定义 JVM 参数" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                    <TextBox Text="{Binding JvmArguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"
                             ToolTip="例如 -XX:+UseG1GC -Dfile.encoding=UTF-8" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                        <Button Content="检查完整性 / 修复" Style="{StaticResource SecondaryButton}" Command="{Binding VerifyCommand}" Margin="8,0,0,0" />
                        <Button Content="打开游戏目录" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="打开版本目录" Style="{StaticResource GhostButton}" Command="{Binding OpenVersionFolderCommand}" />
                        <Button Content="导出整合包" Style="{StaticResource SecondaryButton}" Command="{Binding ExportPackCommand}" Margin="8,0,0,0" />
                        <Button Content="删除版本" Style="{StaticResource DangerFilledButton}" Command="{Binding DeleteCommand}" Margin="8,0,0,0" Padding="16,7"
                                ToolTip="把整个版本目录放进 Windows 回收站，可从资源管理器还原" />
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                               Text="删除版本时不会永久删除文件：整个版本目录会被放进 Windows 回收站，可从资源管理器还原。外部导入的版本只会解除注册，绝不修改原目录。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
