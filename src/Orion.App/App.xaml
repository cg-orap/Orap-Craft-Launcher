<Application x:Class="Orion.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Orion.App.Converters"
             xmlns:views="clr-namespace:Orion.App.Views"
             xmlns:vm="clr-namespace:Orion.App.ViewModels"
             xmlns:v="clr-namespace:Orion.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:BytesConverter x:Key="Bytes" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:InitialConverter x:Key="Initial" />
            <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
            <conv:NotEqualsToVisibilityConverter x:Key="NotEqualsToVisibility" />
    <conv:StateToVisibilityConverter x:Key="StateToVisibility" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />

            <!-- Implicit templates map view models onto views, so navigation stays pure MVVM. -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
                <views:VersionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstancesViewModel}">
                <views:InstancesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SavesViewModel}">
            <views:SavesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SpaceViewModel}">
            <views:SpaceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ContentViewModel}">
            <views:ContentView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ModsViewModel}">
                <views:ModsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
                <views:DownloadsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ToolboxViewModel}">
            <v:ToolboxView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BackupViewModel}">
                <views:BackupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CatalogViewModel}">
                <views:CatalogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VersionPickerViewModel}">
                <views:VersionPickerView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
