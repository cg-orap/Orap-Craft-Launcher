<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Orion.App</RootNamespace>
    <AssemblyName>OrapCraftLauncher</AssemblyName>
    <Product>Orap Craft Launcher</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orion.Core\Orion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 标题栏与启动遮罩用的启动器图标（WPF 资源，pack URI 引用） -->
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded browser for the in-app Microsoft sign-in (same approach as mainstream
         launchers): the user picks an account in a real browser surface, the launcher intercepts
         the OAuth redirect and no Azure app registration or copy/paste is needed.
         The WebView2 *runtime* is Evergreen and provided by Windows, not shipped by us. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- 真实 CPU / GPU 占用：PerformanceCounter 读取 Processor 与 GPU Engine 计数器 -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
  </ItemGroup>

  <!-- Self-contained single-file publish profile (see build/build.ps1). -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>




  <!-- cubiomes 原生引擎：由 build/build-native.ps1 生成，缺失时启动器自动回退到简化模型 -->
  <Target Name="CopyNativeEngineToOutput" AfterTargets="Build" Condition="Exists('..\Orion.Core\Native\OrapCubiomes.dll')">
    <Copy SourceFiles="..\Orion.Core\Native\OrapCubiomes.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyNativeEngineToPublish" AfterTargets="Publish" Condition="Exists('..\Orion.Core\Native\OrapCubiomes.dll')">
    <Copy SourceFiles="..\Orion.Core\Native\OrapCubiomes.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
