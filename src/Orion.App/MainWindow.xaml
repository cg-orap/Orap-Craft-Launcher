<Window x:Class="Orion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:Orion.App.Controls"
        xmlns:anim="clr-namespace:Orion.App.Animations"
        mc:Ignorable="d"
        Title="Orap Craft Launcher — Minecraft Java 版启动器"
        Height="680" Width="1120" MinHeight="600" MinWidth="980"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 一级导航：仅图标，选中时主色 + 左侧竖条 -->
        <Style x:Key="RailItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- 悬停提示：模板里那个空 Grid 没有背景、命中不到，ToolTip 必须挂在 ListBoxItem 上 -->
            <Setter Property="ToolTip" Value="{Binding Title}" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="ToolTipService.HorizontalOffset" Value="6" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="40" Margin="0,2">
                            <Border x:Name="Fill" CornerRadius="8" Background="Transparent" />
                            <Border x:Name="Bar" Width="2" Height="20" CornerRadius="1" HorizontalAlignment="Left"
                                    Background="Transparent" />
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceAltBg}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏实例条目：长条行，选中提亮 -->
        <Style x:Key="SidebarInstanceStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Fill" CornerRadius="6" Background="Transparent" Padding="8,6" Margin="0,1">
                            <Grid>
                                <ContentPresenter />
                                <!-- hover/选中：强调色淡罩在内容之上，120ms 过渡（原来是瞬换底色） -->
                                <Border x:Name="Hover" CornerRadius="5" Opacity="0" IsHitTestVisible="False"
                                        Background="{DynamicResource AccentBrush}" />
                                <Border x:Name="Selected" CornerRadius="5" Opacity="0" IsHitTestVisible="False"
                                        Background="{DynamicResource AccentBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0.08" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                             To="0.16" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 自定义标题栏（40px，可拖拽） ============ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <!-- 启动器标志：用真正的应用图标（原先是蓝底 + 黑方块占位） -->
                    <Border Width="22" Height="22" CornerRadius="5" Margin="0,0,9,0"
                            Background="Transparent" ClipToBounds="True">
                        <Image Source="Assets/app-icon.png" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.AutomationId="TitleBarLogo" />
                    </Border>
                    <TextBlock Text="Orap Craft" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="v0.2" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding InstanceDisplay}" FontSize="11.5"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 图标用矢量绘制：Segoe 图标字体在部分机器上缺字形，会显示成方框 -->
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="OnMinimize"
                            AutomationProperties.AutomationId="CaptionMinimize" ToolTip="最小化">
                        <Path Data="M 0,5 L 10,5" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="OnClose"
                            AutomationProperties.AutomationId="CaptionClose" ToolTip="关闭启动器">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 背景层 -->
        <Rectangle Grid.Row="1" Fill="{DynamicResource WindowBg}" />
        <Image Grid.Row="1" Source="{Binding Home.BackgroundImage}" Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding Home.HasBackgroundImage, Converter={StaticResource BoolToVisibility}}" />
        <Rectangle Grid.Row="1" Fill="{DynamicResource ScrimBrush}"
                   Visibility="{Binding Home.HasBackgroundImage, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 一级导航 Rail（72px，仅图标） ============ -->
            <Border Grid.Column="0" Background="{DynamicResource NavRailBg}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- 选中指示器：跟随当前导航项滑动 -->
                    <Border x:Name="RailIndicator" Width="2" Height="20" CornerRadius="1" Opacity="0"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                    </Border>
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Margin="12,0,12,12" Width="40" Height="40" Padding="0"
                            Cursor="Hand" Command="{Binding OpenLoginCommand}"
                            AutomationProperties.AutomationId="AccountButton"
                            ToolTip="{Binding AccountDisplay}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Fill" CornerRadius="10" Background="{DynamicResource SurfaceAltBg}"
                                        BorderThickness="1" BorderBrush="Transparent">
                                    <Grid>
                                        <Border CornerRadius="6" Margin="4"
                                                Visibility="{Binding HasCurrentAccountAvatar, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                            <TextBlock Text="{Binding CurrentAccount.Username, Converter={StaticResource Initial}}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="6" Margin="4" ClipToBounds="True"
                                                Visibility="{Binding HasCurrentAccountAvatar, Converter={StaticResource BoolToVisibility}}">
                                            <Image Source="{Binding CurrentAccountAvatar}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                        <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ListBox x:Name="NavList" ItemsSource="{Binding NavView}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="12,12,12,0"
                             ItemContainerStyle="{StaticResource RailItemStyle}"
                             PreviewMouseLeftButtonDown="OnNavClick"
                             SelectionChanged="OnNavSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">

                    </ListBox>
                </DockPanel>
                </Grid>
            </Border>

            <!-- ============ 二级侧栏（280 / 44，可折叠，宽度带动画） ============ -->
            <Border x:Name="SidebarHost" Grid.Column="1" Background="{DynamicResource NavRailBg}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="280" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="44" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="280" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- 折叠/展开按钮：两种状态同一坐标（左 6，上 24） -->
                    <Button x:Name="SidebarToggle" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="6,24,0,0" Width="32" Height="32" Padding="0" Cursor="Hand"
                            Command="{Binding ToggleSidebarCommand}"
                            AutomationProperties.AutomationId="SidebarToggle"

                            Style="{StaticResource IconSquareButton}">
                        <TextBlock Text="{Binding SidebarToggleGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <!-- 展开态内容：标题 + 实例列表 + 底部占用 -->
                    <DockPanel Margin="0,80,0,0"
                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="备份占用" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding BackupUsageText}" FontSize="10.5"
                                               HorizontalAlignment="Right" FontFamily="Consolas"
                                               ToolTip="所有实例的备份快照占用 / 配额（可在设置里调整）">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BackupUsageNearLimit}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ProgressBar Value="{Binding BackupUsagePercent, Mode=OneWay}" Maximum="100" Height="4"
                                             Margin="0,6,0,0" ToolTip="备份占用比例" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="12,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Border Background="{DynamicResource SurfaceBg}" CornerRadius="6"
                                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10" Foreground="{DynamicResource MutedTextBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="搜索实例…" FontSize="11.5"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding Home.Instances}"
                                     SelectedItem="{Binding Home.SelectedLaunchInstance, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource SidebarInstanceStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                                    Margin="0,0,8,0" Background="{DynamicResource SurfaceBg}"
                                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,1,0,0"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ============ 内容区 ============ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource WindowBg}"
                        Visibility="{Binding IsHomeSelected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                                <ContentControl x:Name="PageHost" Grid.Row="0" Content="{Binding CurrentPage}"
                                anim:ContentTransition.Watch="{Binding CurrentPage}"
                                anim:ContentTransition.Offset="12"
                                anim:ContentTransition.Duration="240"
                                Margin="0,0,0,0"
                                RenderTransformOrigin="0.5,0">
                    <ContentControl.RenderTransform>
                        <TranslateTransform Y="0" />
                    </ContentControl.RenderTransform>
                </ContentControl>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceBg}"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                        Padding="18,7">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Activities.IsBusy}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Activities.Status}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" Text="{Binding VersionStatus}"
                                   Style="{StaticResource CaptionText}" />
                    </Grid>
                </Border>

                <!-- 初始化遮罩：应用图标 + 旋转加载环 + 状态文字 -->
                <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource WindowBg}"
                        Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="76" Height="76" CornerRadius="20" ClipToBounds="True"
                                HorizontalAlignment="Center">
                            <Image Source="Assets/app-icon.png" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <TextBlock Text="Orap Craft Launcher" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,18,0,0" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <controls:LoadingSpinner Size="16" Thickness="2.2"
                                                     Stroke="{DynamicResource AccentBrush}"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="正在初始化…" Style="{StaticResource CaptionText}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
