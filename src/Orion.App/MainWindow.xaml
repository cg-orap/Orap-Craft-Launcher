<Window x:Class="Orion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Orap Craft Launcher — Minecraft Java 版启动器"
        Height="784" Width="1260" MinHeight="784" MinWidth="1260" MaxHeight="784" MaxWidth="1260"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Navigation entry: rounded hover, accent bar and accent label when selected. -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid MinHeight="40" Margin="0,2">
                            <Border x:Name="Fill" CornerRadius="8" Background="Transparent" />
                            <Border x:Name="Bar" Width="3" CornerRadius="2" HorizontalAlignment="Left"
                                    Margin="0,8,0,8" Background="Transparent" />
                            <ContentPresenter Margin="14,9,10,9" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceAltBg}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= custom title bar ======================= -->
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                    <TextBlock Text="O" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Orap Craft Launcher" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="v0.1.0" FontSize="10.5" Margin="8,3,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="打造一个好用、好看的 Minecraft 启动器"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" Opacity="0.65"
                       Foreground="{DynamicResource MutedTextBrush}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Content="—" Style="{StaticResource CaptionButton}" Click="OnMinimize"
                        AutomationProperties.AutomationId="CaptionMinimize" />
                <Button x:Name="CloseButton" Content="✕" Style="{StaticResource CaptionButton}" Click="OnClose"
                        AutomationProperties.AutomationId="CaptionClose" />
            </StackPanel>
        </Grid>

        <!-- layer 0: palette background (also what the translucent rail blends into) -->
        <Rectangle Grid.Row="1" Fill="{DynamicResource WindowBg}" />

        <!-- layer 1: user wallpaper, shared by every page -->
        <Image Grid.Row="1" Source="{Binding Home.BackgroundImage}" Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding Home.HasBackgroundImage, Converter={StaticResource BoolToVisibility}}" />

        <!-- layer 2: scrim so cards and text stay readable over any picture -->
        <Rectangle Grid.Row="1" Fill="{DynamicResource ScrimBrush}"
                   Visibility="{Binding Home.HasBackgroundImage, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- ======================= navigation rail ======================= -->
        <Border Grid.Column="0" Background="{DynamicResource NavRailBg}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- account: first entry of the rail, opens the login window -->
                <Button DockPanel.Dock="Bottom" Margin="10,10,10,10" Padding="0" Cursor="Hand"
                        Command="{Binding OpenLoginCommand}"
                        AutomationProperties.AutomationId="AccountButton"
                        ToolTip="点击登录 / 切换账户">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fill" Background="{DynamicResource SurfaceAltBg}"
                                    CornerRadius="10" Padding="10" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                    <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- skin head (falls back to an initial badge) -->
                        <Grid Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border CornerRadius="6" Background="{DynamicResource SurfaceBg}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                    Visibility="{Binding HasCurrentAccountAvatar, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <TextBlock Text="{Binding CurrentAccount.Username, Converter={StaticResource Initial}}"
                                           FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="6" ClipToBounds="True"
                                    Visibility="{Binding HasCurrentAccountAvatar, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding CurrentAccountAvatar}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AccountDisplay}" FontWeight="SemiBold" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding AccountDetail}" Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- nav -->
                <ListBox ItemsSource="{Binding NavView}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Margin="10,0,10,0"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         PreviewMouseLeftButtonDown="OnNavClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="14,10,0,4" Opacity="0.55"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Width="22" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- second level: the five download tabs, unfolded by clicking 下载中心 -->
                                <ItemsControl ItemsSource="{Binding SubItems}" Margin="16,4,0,2"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" Padding="10,5" Margin="0,2,0,0"
                                                    Content="{Binding Title}"
                                                    FontSize="12.5"
                                                    Command="{Binding DataContext.OpenCatalogKindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ======================= page host ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Only the home page shows the wallpaper; every other page gets a solid backdrop so
                 text stays readable. The translucent rail still blends over the picture. -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource WindowBg}"
                    Visibility="{Binding IsHomeSelected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

            <ContentControl Grid.Row="0" Content="{Binding CurrentPage}" />

            <!-- status bar -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBg}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                    Padding="18,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Activities.IsBusy}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Activities.Status}" Style="{StaticResource CaptionText}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding VersionStatus}" Style="{StaticResource CaptionText}" />
                </Grid>
            </Border>

            <!-- initialisation overlay -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource WindowBg}"
                    Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="O" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Orap Craft Launcher" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="正在初始化…" Style="{StaticResource CaptionText}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="240" Margin="0,18,0,0" Height="4" />
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
