<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orion.Core\Orion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- cubiomes 原生引擎（由 build/build-native.ps1 生成；缺失时启动器自动回退到简化模型） -->
    <None Include="..\..\src\Orion.Core\Native\OrapCubiomes.dll" Link="OrapCubiomes.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\src\Orion.Core\Native\OrapCubiomes.dll')" />
  </ItemGroup>

