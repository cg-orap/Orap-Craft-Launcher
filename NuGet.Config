<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-local NuGet configuration.

  Why this file exists:
    The build machine used for this project had a machine-wide NuGet source
    pointing at a folder that does not exist on disk, which made every
    restore fail with NU1301. A repository-local config overrides machine
    settings for this solution only, so no developer's machine-wide NuGet
    configuration is modified.

  * clear  -> ignore inherited machine/user sources (including the broken one)
  * nuget.azure.cn -> reachable mirror used during development
  * nuget.org -> canonical source, kept as a fallback
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="nuget-cn" value="https://nuget.azure.cn/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- A machine-wide Microsoft.VisualStudio.FallbackLocation.config listed a
       fallback package folder that no longer exists; clearing it here keeps the
       repository restore self-contained. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuget-cn">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
